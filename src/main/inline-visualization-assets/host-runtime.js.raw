    if (typeof value !== 'object' || depth > 20) return false;
    if (applyIntrinsic(weakSetHas, seen, [value])) return false;
    applyIntrinsic(weakSetAdd, seen, [value]);
    if (arrayIsArray(value)) {
      for (let index = 0; index < value.length; index += 1) {
        if (!isJsonValue(value[index], seen, depth + 1)) return false;
      }
      applyIntrinsic(weakSetDelete, seen, [value]);
      return true;
    }
    const prototype = objectGetPrototypeOf(value);
    if (prototype !== objectPrototype && prototype !== null) return false;
    const keys = applyIntrinsic(objectKeys, Object, [value]);
    for (let index = 0; index < keys.length; index += 1) {
      if (!isJsonValue(value[keys[index]], seen, depth + 1)) return false;

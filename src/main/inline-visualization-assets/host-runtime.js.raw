    try {
      const monotonicNow = performance.now.bind(performance);
      const observer = new PerformanceObserver((list) => {
        const now = monotonicNow();
        const entries = applyIntrinsic(entryListGetEntries, list, []);
        for (let index = 0; index < entries.length; index += 1) {
          const duration = applyIntrinsic(performanceEntryDurationGetter, entries[index], []);
          if (numberIsFinite(duration) && duration > 0) {
            applyIntrinsic(arrayPush, longTaskSamples, [{ recordedAt: now, duration }]);

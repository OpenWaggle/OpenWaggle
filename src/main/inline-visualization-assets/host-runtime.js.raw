        const cutoff = now - RESOURCE_BUDGET_WINDOW_MS;
        while (longTaskSamples[0]?.recordedAt < cutoff) {
          applyIntrinsic(arrayShift, longTaskSamples, []);
        }
        let blockedTime = 0;
        for (let index = 0; index < longTaskSamples.length; index += 1) {
          blockedTime += longTaskSamples[index].duration;

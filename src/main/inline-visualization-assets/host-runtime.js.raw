    const getPrototypeOf = Object.getPrototypeOf;
    const getOwnPropertyDescriptor = Object.getOwnPropertyDescriptor;
    const apply = Reflect.apply;
    let owner = activation;
    while (owner) {
      const getter = getOwnPropertyDescriptor(owner, 'isActive')?.get;
      if (typeof getter === 'function') {
        return () => {
          try {
            return apply(getter, activation, []) === true;
          } catch {
            return false;
          }
        };
      }
      owner = getPrototypeOf(owner);
    }
    return () => false;
  })();
  const hasCurrentTrustedFrameInput = (() => {
    const getPrototypeOf = Object.getPrototypeOf;
    const getOwnPropertyDescriptor = Object.getOwnPropertyDescriptor;
    const apply = Reflect.apply;
    const findGetter = (value, property) => {
      let owner = value;
      while (owner) {
        const getter = getOwnPropertyDescriptor(owner, property)?.get;
        if (typeof getter === 'function') return getter;
        owner = getPrototypeOf(owner);
      }
      return null;
    };
    const currentEventGetter = findGetter(window, 'event');

  const RESOURCE_BUDGET_WINDOW_MS = 5000;
  const MAX_LONG_TASK_BUDGET_MS = 1000;
  const longTaskSamples = [];
  const arrayPush = Array.prototype.push;
  const arrayShift = Array.prototype.shift;
  const numberIsFinite = Number.isFinite;
  const applyIntrinsic = Reflect.apply;
  const entryListGetEntries = typeof PerformanceObserverEntryList === 'function'
    ? PerformanceObserverEntryList.prototype.getEntries
    : null;
  const performanceEntryDurationGetter = typeof PerformanceEntry === 'function'
    ? Object.getOwnPropertyDescriptor(PerformanceEntry.prototype, 'duration')?.get
    : null;
  let resourceLimitReported = false;
  const reportResourceLimit = () => {
    if (resourceLimitReported) return;
    resourceLimitReported = true;
    post('openwaggle:inline-visualization:resource-limit');
  };

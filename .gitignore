node_modules/
out/
# pi agent harness working state (goals, session scratch) - never part of the repo. The
# project Pi extensions in .pi/extensions are tracked.
.pi/*
!.pi/extensions/

# tsc typecheck byproducts (declarations + build info), namespaced per target. Kept
# out of out/ so they are never packaged by electron-builder's `out/**/*` glob.
.typecheck/
dist/
dist-cjs/
.pack/
coverage/
playwright-report/
test-results/
.env
*.log
# LevelDB write-ahead logs are test fixtures, not logs.
!src/main/electron-migration/__tests__/fixtures/**/*.log
.DS_Store
__pycache__/
.openwaggle/settings.json
.openwaggle/mcp.json
.openwaggle/extensions/
.pi/settings.json
.pi/mcp.json
.pi/.npm-cache/
.pi/npm/
.pi/git/

.tmp-*
tmp/
.tmp/

build/openwaggle-docs/
build/session-embedding-model/

# Tesseract.js otherwise caches downloaded OCR language data in the current directory.
/eng.traineddata

.playwright-mcp/

.fallow

# The Electrobun devkit Hutch projects into the checkout (`bunx electrobun prepare`, ADR 0064).
.hutch/
# TypeScript incremental build artifacts
*.tsbuildinfo

# Local herdr orchestration config (machine-specific)
.agents/skills/herdr-orchestration/.herdr-config.json

# Config bundles Vite and electron-vite write next to their config while loading it; the check
# runner's parallel steps (format, repository standards) must not see them.
electron.vite.config.*.mjs
*.timestamp-*.mjs

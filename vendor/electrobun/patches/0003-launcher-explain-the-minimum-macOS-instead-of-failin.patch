diff --git a/package/src/launcher/macos_minimum.zig b/package/src/launcher/macos_minimum.zig
new file mode 100644
index 00000000..e56e7bec
--- /dev/null
+++ b/package/src/launcher/macos_minimum.zig
@@ -0,0 +1,111 @@
+//! Optional macOS version gate for the launcher. Apps whose launcher targets an older macOS than
+//! the rest of the bundle (ELECTROBUN_MACOS_LAUNCHER_DEPLOYMENT_TARGET) set the version their
+//! runtime needs with -Dmacos-required-version. Below it, the launcher explains the requirement in
+//! a native alert and exits instead of starting a runtime that would crash at load time.
+const std = @import("std");
+const builtin = @import("builtin");
+
+pub const Version = struct {
+    major: u32,
+    minor: u32 = 0,
+    patch: u32 = 0,
+
+    pub fn parse(text: []const u8) ?Version {
+        var parts = std.mem.splitScalar(u8, std.mem.trim(u8, text, " \t\r\n\x00"), '.');
+        const major = std.fmt.parseInt(u32, parts.next() orelse return null, 10) catch return null;
+        const minor = if (parts.next()) |part| std.fmt.parseInt(u32, part, 10) catch return null else 0;
+        const patch = if (parts.next()) |part| std.fmt.parseInt(u32, part, 10) catch return null else 0;
+        if (parts.next() != null) return null;
+        return .{ .major = major, .minor = minor, .patch = patch };
+    }
+
+    pub fn isBelow(self: Version, other: Version) bool {
+        if (self.major != other.major) return self.major < other.major;
+        if (self.minor != other.minor) return self.minor < other.minor;
+        return self.patch < other.patch;
+    }
+};
+
+extern "c" fn sysctlbyname(
+    name: [*:0]const u8,
+    oldp: ?*anyopaque,
+    oldlenp: ?*usize,
+    newp: ?*anyopaque,
+    newlen: usize,
+) c_int;
+
+fn currentVersionText(buffer: []u8) ?[]const u8 {
+    var length: usize = buffer.len;
+    if (sysctlbyname("kern.osproductversion", buffer.ptr, &length, null, 0) != 0) return null;
+    if (length == 0) return null;
+    return std.mem.trimEnd(u8, buffer[0..length], "\x00");
+}
+
+/// "OpenWaggle" for ".../OpenWaggle.app/Contents/MacOS/launcher"; null outside a bundle.
+pub fn bundleName(exe_path: []const u8) ?[]const u8 {
+    const marker = ".app/Contents/MacOS/";
+    const end = std.mem.lastIndexOf(u8, exe_path, marker) orelse return null;
+    const start = if (std.mem.lastIndexOfScalar(u8, exe_path[0..end], '/')) |slash| slash + 1 else 0;
+    return exe_path[start..end];
+}
+
+fn appendAppleScriptString(list: *std.ArrayList(u8), allocator: std.mem.Allocator, text: []const u8) !void {
+    try list.append(allocator, '"');
+    for (text) |char| {
+        if (char == '"' or char == '\\') try list.append(allocator, '\\');
+        try list.append(allocator, char);
+    }
+    try list.append(allocator, '"');
+}
+
+/// Returns normally when the gate is disabled, the version is unknown, or the Mac is new enough.
+pub fn enforce(
+    allocator: std.mem.Allocator,
+    io: std.Io,
+    environ_map: *std.process.Environ.Map,
+    exe_path: []const u8,
+    required_text: []const u8,
+) void {
+    if (builtin.os.tag != .macos or required_text.len == 0) return;
+    const required = Version.parse(required_text) orelse return;
+    var buffer: [64]u8 = undefined;
+    const current_text = currentVersionText(&buffer) orelse return;
+    const current = Version.parse(current_text) orelse return;
+    if (!current.isBelow(required)) return;
+
+    const name = bundleName(exe_path) orelse "This app";
+    std.debug.print("{s} needs macOS {s} or later; this Mac runs {s}.\n", .{ name, required_text, current_text });
+    var script: std.ArrayList(u8) = .empty;
+    defer script.deinit(allocator);
+    const title = std.fmt.allocPrint(allocator, "{s} needs macOS {s} or later", .{ name, required_text }) catch std.process.exit(1);
+    const detail = std.fmt.allocPrint(allocator, "This Mac runs macOS {s}. Update macOS to keep using {s}.", .{ current_text, name }) catch std.process.exit(1);
+    script.appendSlice(allocator, "display alert ") catch std.process.exit(1);
+    appendAppleScriptString(&script, allocator, title) catch std.process.exit(1);
+    script.appendSlice(allocator, " message ") catch std.process.exit(1);
+    appendAppleScriptString(&script, allocator, detail) catch std.process.exit(1);
+    script.appendSlice(allocator, " as critical") catch std.process.exit(1);
+    if (std.process.spawn(io, .{
+        .argv = &.{ "/usr/bin/osascript", "-e", script.items },
+        .environ_map = environ_map,
+        .stdout = .ignore,
+        .stderr = .inherit,
+    })) |child| {
+        var alert = child;
+        _ = alert.wait(io) catch {};
+    } else |_| {}
+    std.process.exit(1);
+}
+
+test "parses and compares macOS versions" {
+    const required = Version.parse("13.4").?;
+    try std.testing.expect(Version.parse("12.7.6").?.isBelow(required));
+    try std.testing.expect(Version.parse("13.3.1").?.isBelow(required));
+    try std.testing.expect(!Version.parse("13.4").?.isBelow(required));
+    try std.testing.expect(!Version.parse("14.0").?.isBelow(required));
+    try std.testing.expect(Version.parse("13.x") == null);
+}
+
+test "names the enclosing app bundle" {
+    try std.testing.expectEqualStrings("OpenWaggle", bundleName("/Applications/OpenWaggle.app/Contents/MacOS/launcher").?);
+    try std.testing.expect(bundleName("/usr/local/bin/launcher") == null);
+}

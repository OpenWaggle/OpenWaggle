index da73319c..b7995687 100644
--- a/package/build.ts
+++ b/package/build.ts
@@ -2597,6 +2597,10 @@ async function buildLauncher() {
 		zigArgs = [`-Dtarget=${linuxZigTarget(ARCH)}`];
 	} else if (OS === "macos") {
 		zigArgs = [`-Dtarget=${macosZigTarget(ARCH, MACOS_LAUNCHER_DEPLOYMENT_TARGET)}`];
+		// Explain the runtime's minimum instead of crashing when the launcher
+		// targets an older macOS than the rest of the app (macos_minimum.zig).
+		const requiredVersion = process.env["ELECTROBUN_MACOS_REQUIRED_VERSION"] ?? "";

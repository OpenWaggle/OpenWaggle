diff --git a/package/src/launcher/remote_debugging_port.test.ts b/package/src/launcher/remote_debugging_port.test.ts
new file mode 100644
index 00000000..4358cb38
--- /dev/null
+++ b/package/src/launcher/remote_debugging_port.test.ts
@@ -0,0 +1,60 @@
+import { afterEach, describe, expect, it } from "bun:test";
+import { mkdtempSync, rmSync, writeFileSync } from "fs";
+import { tmpdir } from "os";
+import { join } from "path";
+import {
+	configuredRemoteDebuggingPort,
+	preparePerLaunchRemoteDebuggingPort,
+	REMOTE_DEBUGGING_PORT_ENVIRONMENT,
+	reserveLoopbackPort,
+} from "./remote_debugging_port";
+
+const directories: string[] = [];
+
+function resources(build: unknown) {
+	const directory = mkdtempSync(join(tmpdir(), "electrobun-port-"));
+	directories.push(directory);
+	writeFileSync(join(directory, "build.json"), JSON.stringify(build));
+	return directory;
+}
+
+afterEach(() => {
+	delete process.env[REMOTE_DEBUGGING_PORT_ENVIRONMENT];
+	for (const directory of directories.splice(0)) {
+		rmSync(directory, { recursive: true, force: true });
+	}
+});
+
+describe("per-launch CEF remote debugging port", () => {
+	it("reads the configured port from build.json", () => {
+		const directory = resources({ chromiumFlags: { "remote-debugging-port": "launch" } });
+		expect(configuredRemoteDebuggingPort(join(directory, "build.json"))).toBe("launch");
+		expect(configuredRemoteDebuggingPort(join(directory, "missing.json"))).toBeUndefined();
+	});
+
+	it("reserves a free loopback port", () => {
+		const port = reserveLoopbackPort();
+		expect(port).toBeGreaterThanOrEqual(1024);
+		expect(port).toBeLessThanOrEqual(65535);
+	});
+
+	it("sets a new port only when the build asks for one", () => {
+		preparePerLaunchRemoteDebuggingPort(
+			resources({ chromiumFlags: { "remote-debugging-port": "9222" } }),
+		);
+		expect(process.env[REMOTE_DEBUGGING_PORT_ENVIRONMENT]).toBeUndefined();
+
+		preparePerLaunchRemoteDebuggingPort(
+			resources({ chromiumFlags: { "remote-debugging-port": "launch" } }),
+		);
+		expect(process.env[REMOTE_DEBUGGING_PORT_ENVIRONMENT]).toMatch(/^\d+$/);
+	});
+
+	it("keeps a port the environment already names", () => {
+		process.env[REMOTE_DEBUGGING_PORT_ENVIRONMENT] = "9444";
+		preparePerLaunchRemoteDebuggingPort(
+			resources({ chromiumFlags: { "remote-debugging-port": "launch" } }),
+		);
+		expect(process.env[REMOTE_DEBUGGING_PORT_ENVIRONMENT]).toBe("9444");
+	});
+});
diff --git a/package/src/launcher/remote_debugging_port.ts b/package/src/launcher/remote_debugging_port.ts
new file mode 100644
index 00000000..59a01de9
--- /dev/null
+++ b/package/src/launcher/remote_debugging_port.ts
@@ -0,0 +1,108 @@
+import { dlopen } from "bun:ffi";
+import { existsSync, readFileSync } from "fs";
+import { join } from "path";
+
+// Keep in sync with kRemoteDebuggingPortEnvironment in native/shared/chromium_flags.h.
+export const REMOTE_DEBUGGING_PORT_ENVIRONMENT = "ELECTROBUN_CEF_REMOTE_DEBUGGING_PORT";
+
+/** The chromiumFlags value that asks for a new loopback port on every launch. */
+export const PER_LAUNCH_REMOTE_DEBUGGING_PORT = "launch";
+
+const LOOPBACK_HOST = "127.0.0.1";
+
+/** chromiumFlags["remote-debugging-port"] from the app's build.json, if any. */
+export function configuredRemoteDebuggingPort(buildJsonPath: string): unknown {
+	if (!existsSync(buildJsonPath)) return undefined;
+	const build: unknown = JSON.parse(readFileSync(buildJsonPath, "utf8"));
+	if (typeof build !== "object" || build === null) return undefined;
+	const flags: unknown = Reflect.get(build, "chromiumFlags");
+	if (typeof flags !== "object" || flags === null) return undefined;
+	return Reflect.get(flags, "remote-debugging-port");
+}
+
+/** A loopback port that was free a moment ago; CEF binds it a moment later. */
+export function reserveLoopbackPort(): number {
+	const listener = Bun.listen({
+		hostname: LOOPBACK_HOST,
+		port: 0,
+		socket: { data() {} },
+	});
+	const port = listener.port;
+	listener.stop(true);
+	return port;
+}
+
+function nullTerminatedUtf16(value: string) {
+	const units = new Uint16Array(value.length + 1);
+	for (let index = 0; index < value.length; index++) {
+		units[index] = value.charCodeAt(index);
+	}
+	return units;
+}
+
+/**
+ * Sets a variable in the process environment the native layer reads with getenv. Bun's
+ * process.env does not reach the C runtime's environment, so this goes through the OS: libc's
+ * setenv, or SetEnvironmentVariableW on Windows, where the native DLLs (static C runtime) are
+ * loaded afterwards and copy the process environment block when they start.
+ */
+export function setNativeEnvironmentVariable(name: string, value: string) {
+	if (process.platform === "win32") {
+		const kernel32 = dlopen("kernel32.dll", {
+			SetEnvironmentVariableW: { args: ["ptr", "ptr"], returns: "i32" },
+		});
+		try {
+			const set = kernel32.symbols.SetEnvironmentVariableW(
+				nullTerminatedUtf16(name),
+				nullTerminatedUtf16(value),
+			);
+			if (set === 0) throw new Error("SetEnvironmentVariableW failed");
+		} finally {
+			kernel32.close();
+		}
+	} else {
+		const libc = dlopen(
+			process.platform === "darwin" ? "libSystem.B.dylib" : "libc.so.6",
+			{ setenv: { args: ["ptr", "ptr", "i32"], returns: "i32" } },
+		);
+		try {
+			const status = libc.symbols.setenv(
+				Buffer.from(`${name}\0`, "utf8"),
+				Buffer.from(`${value}\0`, "utf8"),
+				1,
+			);
+			if (status !== 0) throw new Error("setenv failed");
+		} finally {
+			libc.close();
+		}
+	}
+	// The app's Worker starts from this process.env.
+	process.env[name] = value;
+}
+
+/**
+ * Gives CEF a new loopback remote-debugging port on every launch when the build asks for one
+ * (chromiumFlags["remote-debugging-port"] = "launch"), before the native layer starts CEF. The app
+ * reads the port from ELECTROBUN_CEF_REMOTE_DEBUGGING_PORT. A port already set in the environment
+ * wins, as it does in the native layer. When no port can be set, CEF reads "launch" as an invalid
+ * port and keeps remote debugging off.
+ */
+export function preparePerLaunchRemoteDebuggingPort(resourcesPath: string) {
+	if (process.env[REMOTE_DEBUGGING_PORT_ENVIRONMENT] !== undefined) return;
+	try {
+		const configured = configuredRemoteDebuggingPort(
+			join(resourcesPath, "build.json"),
+		);
+		if (configured !== PER_LAUNCH_REMOTE_DEBUGGING_PORT) return;
+		const port = reserveLoopbackPort();
+		setNativeEnvironmentVariable(REMOTE_DEBUGGING_PORT_ENVIRONMENT, String(port));
+		console.log(
+			`[LAUNCHER] CEF remote debugging uses the per-launch port ${LOOPBACK_HOST}:${port}`,
+		);
+	} catch (error) {
+		console.error(
+			"[LAUNCHER] Could not choose a per-launch CEF remote debugging port; remote debugging stays off:",
+			error,
+		);
+	}
+}

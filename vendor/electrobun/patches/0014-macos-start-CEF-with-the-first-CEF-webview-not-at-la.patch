+// CEF's external message pump on the Cocoa run loop, after cefclient's
+// MainMessageLoopExternalPumpMac. [NSApp run] owns the main thread from
+// launch; once CEF starts it asks for work through OnScheduleMessagePumpWork
+// (from any thread), and CefDoMessageLoopWork runs here on the main thread,
+// immediately or from a timer, and never later than kCefPumpMaxDelayMs.
+static const int64_t kCefPumpMaxDelayMs = 1000 / 30;
+static const int64_t kCefPumpTimerPlaceholder = INT64_MAX;
+
+@interface ElectrobunCefPump : NSObject
+- (void)scheduleWork:(NSNumber *)delayMs;
+- (void)stop;
+@end
+
+@implementation ElectrobunCefPump {
+  NSTimer *timer_;
+  BOOL active_;
+  BOOL reentrancyDetected_;
+  BOOL stopped_;
+}
+- (void)killTimer {
+  [timer_ invalidate];
+  timer_ = nil;
+}
+- (void)setTimer:(int64_t)delayMs {
+  timer_ = [NSTimer timerWithTimeInterval:(double)delayMs / 1000.0
+                                   target:self
+                                 selector:@selector(timerFired:)
+                                 userInfo:nil
+                                  repeats:NO];
+  NSRunLoop *loop = [NSRunLoop currentRunLoop];
+  [loop addTimer:timer_ forMode:NSRunLoopCommonModes];
+  [loop addTimer:timer_ forMode:NSEventTrackingRunLoopMode];
+}
+- (void)timerFired:(NSTimer *)timer {
+  (void)timer;
+  [self killTimer];
+  [self doWork];
+}
+- (BOOL)performWork {
+  if (active_) {
+    // CefDoMessageLoopWork can call back into OnScheduleMessagePumpWork; the
+    // nested request runs as soon as this one returns.
+    reentrancyDetected_ = YES;
+    return NO;
+  }
+  reentrancyDetected_ = NO;
+  active_ = YES;
+  CefDoMessageLoopWork();
+  active_ = NO;
+  return reentrancyDetected_;
+}
+- (void)doWork {
+  if (stopped_)
+    return;
+  if ([self performWork]) {
+    [self scheduleWork:@(0)];
+  } else if (timer_ == nil) {
+    [self scheduleWork:@(kCefPumpTimerPlaceholder)];
+  }
+}
+- (void)scheduleWork:(NSNumber *)delayNumber {
+  if (stopped_)
+    return;
+  int64_t delayMs = [delayNumber longLongValue];
+  if (delayMs == kCefPumpTimerPlaceholder && timer_ != nil)
+    return;
+  [self killTimer];
+  if (delayMs <= 0) {
+    [self doWork];
+  } else {
+    [self setTimer:MIN(delayMs, kCefPumpMaxDelayMs)];
+  }
+}
+- (void)stop {
+  stopped_ = YES;
+  [self killTimer];
+}
+@end
+
+static ElectrobunCefPump *g_cefPump = nil;
+
+static void scheduleCefMessagePumpWork(int64_t delayMs) {
+  ElectrobunCefPump *pump = g_cefPump;
+  if (pump == nil)
+    return;
+  [pump performSelectorOnMainThread:@selector(scheduleWork:)
+                         withObject:@(delayMs)
+                      waitUntilDone:NO
+                              modes:@[ NSRunLoopCommonModes ]];
+}
+

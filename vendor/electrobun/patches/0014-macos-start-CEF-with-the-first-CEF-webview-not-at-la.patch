 bool initializeCEF() {
   static bool initialized = false;
+  // CefInitialize runs at most once per process, so a failed start is final.
+  static bool failed = false;
   if (initialized)
     return true;
+  if (failed)
+    return false;
 
   [ElectrobunNSApplication sharedApplication];
   if (![NSApp isKindOfClass:[ElectrobunNSApplication class]]) {
+    failed = true;
+    return false;
+  }
+  if (!cef_load_library([cefFrameworkBinary() fileSystemRepresentation])) {
+    NSLog(@"[CEF] Could not load %@", cefFrameworkBinary());
+    failed = true;
     return false;
   }
 

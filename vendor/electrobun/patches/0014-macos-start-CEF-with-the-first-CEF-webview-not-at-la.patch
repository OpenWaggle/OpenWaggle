+  g_cefPump = [[ElectrobunCefPump alloc] init];
   bool result = CefInitialize(main_args, settings, g_app.get(), nullptr);
 
   for (int i = 0; i < argc; i++)
@@ -7621,13 +7737,31 @@ bool initializeCEF() {
   free(argv);
 
   if (!result) {
+    failed = true;
+    [g_cefPump stop];
+    g_cefPump = nil;
     return false;
   }
 
   initialized = true;
+  g_cefStarted = true;
+  scheduleCefMessagePumpWork(0);
   return true;
 }
 
+// After [NSApp run] returns: lets CEF finish pending work, then shuts it down.
+static void shutdownStartedCEF() {
+  if (!g_cefStarted)
+    return;
+  [g_cefPump stop];
+  for (int i = 0; i < 10; i++) {
+    CefDoMessageLoopWork();
+  }
+  CefShutdown();
+  g_cefPump = nil;
+  g_cefStarted = false;
+}

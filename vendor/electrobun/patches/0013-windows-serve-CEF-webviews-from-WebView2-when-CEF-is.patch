+// The remote debugging port of WebView2's Chromium environment, decided once
+// the way CEF decides its own (chromium_flags.h): the environment variable,
+// then build.json's chromiumFlags, then the dev-build scan. 0 serves none.
+static int webView2ChromiumRemoteDebuggingPort() {
+    static const int port = []() {
+        const std::wstring executablePath = electrobun::getModuleFileNameWide();
+        const size_t lastSlash = executablePath.find_last_of(L"\\/");
+        std::string buildJsonContent;
+        if (!executablePath.empty() && lastSlash != std::wstring::npos) {
+            buildJsonContent = electrobun::readFileToString(
+                std::filesystem::path(executablePath.substr(0, lastSlash)) / L".." /
+                L"Resources" / L"build.json");
+        }
+        const electrobun::ChromiumFlagConfig flags = buildJsonContent.empty()
+            ? electrobun::ChromiumFlagConfig{}
+            : electrobun::parseChromiumFlags(buildJsonContent);
+        const auto decision = electrobun::resolveRemoteDebugging(
+            buildJsonContent, flags, getenv(electrobun::kRemoteDebuggingPortEnvironment));
+        const int selected = electrobun::selectRemoteDebuggingPort(decision, IsPortAvailable);
+        if (selected != 0) {
+            std::cout << "[WebView2] Chromium environment remote debugging on 127.0.0.1:"
+                      << selected << " ("
+                      << electrobun::remoteDebuggingSourceName(decision.source) << ")"
+                      << std::endl;
+        }
+        return selected;
+    }();
+    return port;
+}

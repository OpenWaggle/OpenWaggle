diff --git a/package/src/native/shared/webview2_chromium_environment.h b/package/src/native/shared/webview2_chromium_environment.h
new file mode 100644
index 0000000..18db0dc
--- /dev/null
+++ b/package/src/native/shared/webview2_chromium_environment.h
@@ -0,0 +1,108 @@
+#ifndef ELECTROBUN_WEBVIEW2_CHROMIUM_ENVIRONMENT_H
+#define ELECTROBUN_WEBVIEW2_CHROMIUM_ENVIRONMENT_H
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "sha256.h"
+
+namespace electrobun {
+
+/**
+ * Where a `renderer: "cef"` webview lives on Windows when the app bundles no
+ * CEF: one WebView2 environment of its own, apart from the app's other
+ * webviews. It has its own user data folder, so its own browser process, and
+ * only that process serves Chrome DevTools Protocol on the app's remote
+ * debugging port. The app's system-webview windows never appear on the port.
+ *
+ * Partitions map to WebView2 profiles of that one environment, since a
+ * browser process serves one remote debugging port and every user data
+ * folder is a browser process: `persist:<name>` is the on-disk profile
+ * `<name>`; any other name is an InPrivate profile of that name, whose data
+ * lives in memory, is shared by every webview of the partition, and is gone
+ * once none is left.
+ */
+struct WebView2ChromiumProfile {
+    std::wstring profileName;
+    bool inPrivate;
+};
+
+/** The base arguments of every WebView2 browser process Electrobun starts. */
+inline constexpr std::wstring_view kWebView2BrowserArguments =
+    L"--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection";
+
+/**
+ * The browser arguments of the main environment, which serves only the app's
+ * own views. Its GPU and network service run in the browser process, as the
+ * app's own windowless processes run them on the other shells: the views come
+ * from the app, so a crash there was already the app's, and each separate
+ * helper process costs about 40-45 MB. The Chromium environment, which loads
+ * arbitrary sites in the Browser preview, keeps Chromium's process isolation.
+ */
+inline constexpr std::wstring_view kWebView2MainBrowserArguments =
+    L"--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
+    L" --in-process-gpu --enable-features=NetworkServiceInProcess2";
+
+/** The browser arguments of the Chromium environment; port 0 serves no DevTools. */
+inline std::wstring buildWebView2ChromiumBrowserArguments(int remoteDebuggingPort) {
+    std::wstring arguments(kWebView2BrowserArguments);
+    if (remoteDebuggingPort > 0 && remoteDebuggingPort <= 65535) {
+        arguments += L" --remote-debugging-port=";
+        arguments += std::to_wstring(remoteDebuggingPort);
+    }
+    return arguments;
+}
+
+/**
+ * A WebView2 profile name for a partition name. Profile names are at most 64
+ * characters of a restricted ASCII set and compare case-insensitively, so
+ * only short lowercase names (letters, digits, `-`, `_`, no reserved device
+ * name) are kept as they are; every other name becomes `~h-` and 40 hex digits
+ * of the SHA-256 of its UTF-16BE code units (`~` never appears in a kept name).
+ */
+inline std::wstring buildWebView2ProfileName(std::wstring_view name) {
+    bool plain = !name.empty() && name.size() <= 64;
+    for (const wchar_t ch : name) {
+        if (!((ch >= L'a' && ch <= L'z') || (ch >= L'0' && ch <= L'9') ||
+              ch == L'-' || ch == L'_')) {
+            plain = false;
+        }
+    }
+    // Profiles are directories: never a reserved device name.
+    const bool reserved = name == L"con" || name == L"prn" || name == L"aux" ||
+        name == L"nul" ||
+        (name.size() == 4 && (name.substr(0, 3) == L"com" || name.substr(0, 3) == L"lpt") &&
+         name[3] >= L'1' && name[3] <= L'9');
+    if (plain && !reserved) return std::wstring(name);
+    std::string identity;
+    for (const wchar_t ch : name) {
+        const uint32_t value = static_cast<uint32_t>(ch);
+        identity += static_cast<char>((value >> 8) & 0xff);
+        identity += static_cast<char>(value & 0xff);
+    }
+    const std::string digest = sha256Hex(identity).substr(0, 40);
+    return L"~h-" + std::wstring(digest.begin(), digest.end());
+}
+
+/**
+ * The profile of a partition. An empty partition gets an InPrivate profile of
+ * its own, as a CEF webview without a partition gets its own context.
+ */
+inline WebView2ChromiumProfile buildWebView2ChromiumProfile(
+    std::wstring_view partition,
+    uint32_t webviewId
+) {
+    constexpr std::wstring_view persistentPrefix = L"persist:";
+    if (partition.empty()) {
+        return {L"~w-" + std::to_wstring(webviewId), true};
+    }
+    if (partition.rfind(persistentPrefix, 0) == 0) {
+        return {buildWebView2ProfileName(partition.substr(persistentPrefix.size())), false};
+    }
+    return {buildWebView2ProfileName(partition), true};
+}
+
+} // namespace electrobun
+
+#endif
diff --git a/package/src/native/shared/webview2_chromium_environment_test.cpp b/package/src/native/shared/webview2_chromium_environment_test.cpp
new file mode 100644
index 0000000..4a25973
--- /dev/null
+++ b/package/src/native/shared/webview2_chromium_environment_test.cpp
@@ -0,0 +1,60 @@
+#include <cassert>
+#include <iostream>
+#include <string>
+
+#include "webview2_chromium_environment.h"
+
+int main() {
+    using electrobun::buildWebView2ChromiumBrowserArguments;
+    using electrobun::buildWebView2ChromiumProfile;
+    using electrobun::buildWebView2ProfileName;
+
+    // No same-origin bypass, and a DevTools port only when one is chosen.
+    assert(buildWebView2ChromiumBrowserArguments(0) ==
+        L"--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection");
+    assert(buildWebView2ChromiumBrowserArguments(70000) ==
+        buildWebView2ChromiumBrowserArguments(0));
+    assert(buildWebView2ChromiumBrowserArguments(49152) ==
+        L"--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=49152");
+    assert(buildWebView2ChromiumBrowserArguments(49152).find(L"web-security") == std::wstring::npos);
+
+    // The main environment folds its GPU and network helpers into the browser
+    // process and serves no DevTools; the Chromium environment keeps both.
+    const std::wstring main(electrobun::kWebView2MainBrowserArguments);
+    assert(main.rfind(electrobun::kWebView2BrowserArguments, 0) == 0);
+    assert(main.find(L" --in-process-gpu") != std::wstring::npos);
+    assert(main.find(L" --enable-features=NetworkServiceInProcess2") != std::wstring::npos);
+    assert(main.find(L"remote-debugging") == std::wstring::npos);
+    assert(main.find(L"web-security") == std::wstring::npos);
+    assert(buildWebView2ChromiumBrowserArguments(49152).find(L"in-process") == std::wstring::npos);
+
+    // persist:* is an on-disk profile; other names are InPrivate profiles.
+    const auto persistent = buildWebView2ChromiumProfile(L"persist:openwaggle-browser-preview", 3);
+    assert(persistent.profileName == L"openwaggle-browser-preview" && !persistent.inPrivate);
+    const auto named = buildWebView2ChromiumProfile(L"openwaggle-browser-preview-incognito", 3);
+    assert(named.profileName == L"openwaggle-browser-preview-incognito" && named.inPrivate);
+    assert(buildWebView2ChromiumProfile(L"openwaggle-browser-preview-incognito", 9).profileName ==
+        named.profileName);
+    const auto unnamed = buildWebView2ChromiumProfile(L"", 7);
+    assert(unnamed.profileName == L"~w-7" && unnamed.inPrivate);
+    assert(buildWebView2ChromiumProfile(L"", 8).profileName != unnamed.profileName);
+
+    // Profile names: at most 64 characters, case-insensitive, directories.
+    const std::wstring longest(64, L'a');
+    assert(buildWebView2ProfileName(longest) == longest);
+    const std::wstring tooLong(65, L'a');
+    const auto hashed = buildWebView2ProfileName(tooLong);
+    assert(hashed.rfind(L"~h-", 0) == 0 && hashed.size() == 43);
+    assert(buildWebView2ProfileName(L"Work") != buildWebView2ProfileName(L"work"));
+    assert(buildWebView2ProfileName(L"Work") != buildWebView2ProfileName(L"WORK"));
+    assert(buildWebView2ProfileName(L"nul").rfind(L"~h-", 0) == 0);
+    assert(buildWebView2ProfileName(L"com1").rfind(L"~h-", 0) == 0);
+    assert(buildWebView2ProfileName(L"..").rfind(L"~h-", 0) == 0);
+    assert(buildWebView2ProfileName(L"a/b").rfind(L"~h-", 0) == 0);
+    assert(buildWebView2ProfileName(L"").rfind(L"~h-", 0) == 0);
+    // SHA-256 of the UTF-16BE code units of "A".
+    assert(buildWebView2ProfileName(L"A") == L"~h-c00b4d3c929cb5cc316691ed4636f634576f2c9b");
+
+    std::cout << "webview2_chromium_environment_test: ok" << std::endl;
+    return 0;
+}

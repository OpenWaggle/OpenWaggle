diff --git a/package/scripts/linux-release.js b/package/scripts/linux-release.js
new file mode 100644
index 00000000..9f9b619d
--- /dev/null
+++ b/package/scripts/linux-release.js
@@ -0,0 +1,38 @@
+// Linux release targets. By default Zig links against the glibc of its own
+// "linux-gnu" target, and the C++ native wrapper against the build host's
+// glibc and libstdc++. A packager that supports an older distribution than the
+// build host sets ELECTROBUN_LINUX_GLIBC_VERSION (for example "2.35") so every
+// Zig binary links against that glibc, builds the C++ parts on that
+// distribution (or a sysroot of it), and sets ELECTROBUN_LINUX_ABI_BASELINE to
+// the matching limits so package-release.js rejects anything newer.
+const GLIBC_VERSION_PATTERN = /^2\.\d{1,2}$/;
+
+export function resolveLinuxGlibcVersion(value = process.env.ELECTROBUN_LINUX_GLIBC_VERSION) {
+	if (value === undefined || value === "") return null;
+	if (!GLIBC_VERSION_PATTERN.test(value)) {
+		throw new Error(`ELECTROBUN_LINUX_GLIBC_VERSION must look like 2.35, got "${value}"`);
+	}
+	return value;
+}
+
+export function linuxZigTarget(arch, glibcVersion = resolveLinuxGlibcVersion()) {
+	const cpu = arch === "arm64" ? "aarch64" : arch === "x64" ? "x86_64" : null;
+	if (cpu === null) throw new Error(`Unsupported Linux architecture: ${arch}`);
+	return glibcVersion === null ? `${cpu}-linux-gnu` : `${cpu}-linux-gnu.${glibcVersion}`;
+}
+
+const ABI_FAMILIES = ["GLIBC", "GLIBCXX", "CXXABI"];
+
+// "GLIBC=2.35,GLIBCXX=3.4.30,CXXABI=1.3.13" -> { GLIBC: "2.35", ... }
+export function parseLinuxAbiBaseline(value, fallback) {
+	if (value === undefined || value === "") return fallback;
+	const baseline = { ...fallback };
+	for (const entry of value.split(",")) {
+		const [family, version] = entry.split("=").map((part) => part.trim());
+		if (!ABI_FAMILIES.includes(family) || !/^\d+(?:\.\d+)*$/.test(version ?? "")) {
+			throw new Error(`ELECTROBUN_LINUX_ABI_BASELINE entry "${entry}" must be GLIBC|GLIBCXX|CXXABI=<version>`);
+		}
+		baseline[family] = version;
+	}
+	return Object.freeze(baseline);
+}
diff --git a/package/scripts/macos-release.js b/package/scripts/macos-release.js
index 7969d033..1c279f60 100644
--- a/package/scripts/macos-release.js
+++ b/package/scripts/macos-release.js
@@ -1,4 +1,35 @@
-export const MACOS_DEPLOYMENT_TARGET = "14.0";
+// The oldest macOS release every Electrobun binary supports. Packagers that
+// need an older floor can lower it for one build with
+// ELECTROBUN_MACOS_DEPLOYMENT_TARGET (for example "13.4"). The native
+// wrapper is compiled with -Werror=unguarded-availability-new, so a lower
+// target only builds when every newer API is guarded with @available.
+const DEFAULT_MACOS_DEPLOYMENT_TARGET = "14.0";
+const DEPLOYMENT_TARGET_PATTERN = /^(1[1-9]|[2-9]\d)\.\d{1,2}(?:\.\d{1,2})?$/;
+
+export function resolveMacosDeploymentTarget(value, fallback, name) {
+	if (value === undefined || value === "") return fallback;
+	if (!DEPLOYMENT_TARGET_PATTERN.test(value)) {
+		throw new Error(`${name} must be a macOS version such as 13.4, got "${value}"`);
+	}
+	return value;
+}
+
+export const MACOS_DEPLOYMENT_TARGET = resolveMacosDeploymentTarget(
+	process.env.ELECTROBUN_MACOS_DEPLOYMENT_TARGET,
+	DEFAULT_MACOS_DEPLOYMENT_TARGET,
+	"ELECTROBUN_MACOS_DEPLOYMENT_TARGET",
+);
+
+// The launcher and the self-extracting wrapper only use libc and AppKit APIs
+// from macOS 11, so they can target an older release than the rest of the app.
+// That lets an app keep launching (and explain its own minimum, see
+// ELECTROBUN_MACOS_REQUIRED_VERSION) on a macOS release its runtime no longer
+// supports. Defaults to MACOS_DEPLOYMENT_TARGET.
+export const MACOS_LAUNCHER_DEPLOYMENT_TARGET = resolveMacosDeploymentTarget(
+	process.env.ELECTROBUN_MACOS_LAUNCHER_DEPLOYMENT_TARGET,
+	MACOS_DEPLOYMENT_TARGET,
+	"ELECTROBUN_MACOS_LAUNCHER_DEPLOYMENT_TARGET",
+);
 
 export function macosNativeArchitecture(arch) {
 	if (arch === "arm64") return "arm64";
@@ -6,8 +37,8 @@ export function macosNativeArchitecture(arch) {
 	throw new Error(`Unsupported macOS architecture: ${arch}`);
 }
 
-export function macosZigTarget(arch) {
-	if (arch === "arm64") return `aarch64-macos.${MACOS_DEPLOYMENT_TARGET}`;
-	if (arch === "x64") return `x86_64-macos.${MACOS_DEPLOYMENT_TARGET}`;
+export function macosZigTarget(arch, deploymentTarget = MACOS_DEPLOYMENT_TARGET) {
+	if (arch === "arm64") return `aarch64-macos.${deploymentTarget}`;
+	if (arch === "x64") return `x86_64-macos.${deploymentTarget}`;
 	throw new Error(`Unsupported macOS architecture: ${arch}`);
 }

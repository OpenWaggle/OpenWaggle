-// Ubuntu 24.04 ships glibc 2.39 and GCC 13's libstdc++ runtime.
-export const LINUX_ELF_ABI_BASELINE = Object.freeze({
+// Ubuntu 24.04 ships glibc 2.39 and GCC 13's libstdc++ runtime. A packager

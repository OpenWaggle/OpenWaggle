From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diego Garcia Brisa <d.garciabrisa@gmail.com>
Date: Tue, 10 Nov 2026 23:39:22 +0100
Subject: [PATCH] linux: build the Wayland screen capture on Ubuntu 22.04

The Wayland screen capture code needs newer GLib and PipeWire headers
than Ubuntu 22.04 ships (GLib 2.72, PipeWire 0.3.48), so the native
wrapper could not be built there:

- wayland_screen_capture.cpp calls g_unix_fd_list_get without including
  <gio/gunixfdlist.h>. Newer GLib reaches it through <gio/gio.h>; 2.72
  has it only in gio-unix-2.0. Include the header and add gio-unix-2.0
  to the pkg-config flags the capture code is compiled with.
- wayland_pipewire_capture.cpp includes <spa/param/buffers.h>, which
  PipeWire 0.3.48 does not have (the buffer parameters are in
  <spa/param/param.h>), and uses SPA_META_VideoTransform (0.3.62) and
  SPA_CHUNK_FLAG_EMPTY. Include whichever header exists and define the
  missing names, which are protocol values, when the headers lack them.
  A build against old headers still asks a newer PipeWire for video
  transform metadata; an old server never attaches it, which the
  existing lookup already handles.

Compiles against PipeWire 0.3.48 (Ubuntu 22.04) and 1.0.5 (Ubuntu
24.04).
---
 package/build.ts                              |  2 +-
 .../native/linux/wayland_pipewire_capture.cpp | 19 +++++++++++++++++++
 .../native/linux/wayland_screen_capture.cpp   |  2 ++
 3 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/package/build.ts b/package/build.ts
index b7995687..55dcbd45 100644
--- a/package/build.ts
+++ b/package/build.ts
@@ -2458,7 +2458,7 @@ async function buildNative() {
 
 			try {
 				const cflagsResult =
-					await $`pkg-config --cflags libpipewire-0.3`.quiet();
+					await $`pkg-config --cflags libpipewire-0.3 gio-unix-2.0`.quiet();
 				pipewireCflags = cflagsResult.stdout.toString().trim();
 				hasWaylandScreenCapture = true;
 				console.log("Wayland screen capture enabled via PipeWire");
diff --git a/package/src/native/linux/wayland_pipewire_capture.cpp b/package/src/native/linux/wayland_pipewire_capture.cpp
index fbe30615..44f5430a 100644
--- a/package/src/native/linux/wayland_pipewire_capture.cpp
+++ b/package/src/native/linux/wayland_pipewire_capture.cpp
@@ -9,9 +9,28 @@
 #include <pipewire/pipewire.h>
 #include <spa/buffer/buffer.h>
 #include <spa/buffer/meta.h>
+#if __has_include(<spa/param/buffers.h>)
 #include <spa/param/buffers.h>
+#else
+// PipeWire 0.3.48 (Ubuntu 22.04) declares the buffer parameters in param.h.
+#include <spa/param/param.h>
+#endif
 #include <spa/param/video/format-utils.h>
 
+// Building against older PipeWire (Ubuntu 22.04 ships 0.3.48): video transform metadata arrived
+// in 0.3.62 and SPA_CHUNK_FLAG_EMPTY in 0.3.5x. Both are protocol values, so the build still asks a
+// newer server for the metadata; an older server never attaches it, which the lookup handles.
+#if !PW_CHECK_VERSION(0, 3, 62)
+enum : std::uint32_t { SPA_META_VideoTransform = SPA_META_Busy + 1 };
+enum spa_meta_videotransform_value { SPA_META_TRANSFORMATION_None = 0 };
+struct spa_meta_videotransform {
+    std::uint32_t transform;
+};
+#endif
+#ifndef SPA_CHUNK_FLAG_EMPTY
+#define SPA_CHUNK_FLAG_EMPTY (1u << 1)
+#endif
+
 #include <algorithm>
 #include <atomic>
 #include <cmath>
diff --git a/package/src/native/linux/wayland_screen_capture.cpp b/package/src/native/linux/wayland_screen_capture.cpp
index 8655f5eb..b02e8eee 100644
--- a/package/src/native/linux/wayland_screen_capture.cpp
+++ b/package/src/native/linux/wayland_screen_capture.cpp
@@ -6,6 +6,8 @@
 #ifdef ELECTROBUN_ENABLE_WAYLAND_SCREEN_CAPTURE
 
 #include <gio/gio.h>
+// Older GLib (2.72 on Ubuntu 22.04) keeps GUnixFDList out of gio.h, in gio-unix-2.0.
+#include <gio/gunixfdlist.h>
 #include <glib.h>
 
 #include <algorithm>

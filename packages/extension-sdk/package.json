{
  "name": "@openwaggle/extension-sdk",
  "version": "0.3.0",
  "description": "Browser-safe OpenWaggle extension SDK schemas, types, broker helpers, theme tokens, and federated-module context helpers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenWaggle/OpenWaggle.git",
    "directory": "packages/extension-sdk"
  },
  "homepage": "https://openwaggle.ai/docs/packages/extension-sdk/0.2/",
  "bugs": {
    "url": "https://github.com/OpenWaggle/OpenWaggle/issues"
  },
  "keywords": [
    "openwaggle",
    "extension",
    "sdk",
    "typescript",
    "module-federation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "effect": "3.22.2"
  },
  "files": [
    "dist",
    "dist-cjs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./agent-loop": {
      "types": "./dist/agent-loop.d.ts",
      "import": "./dist/agent-loop.js",
      "require": "./dist-cjs/agent-loop.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "require": "./dist-cjs/constants.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist-cjs/context.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js",
      "require": "./dist-cjs/docs.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js",
      "require": "./dist-cjs/json.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist-cjs/runtime.js"
    },
    "./syntax": {
      "types": "./dist/syntax.d.ts",
      "import": "./dist/syntax.js",
      "require": "./dist-cjs/syntax.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist-cjs/testing.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "require": "./dist-cjs/theme.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist-cjs/types.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist-cjs/ui.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "require": "./dist-cjs/validation.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun ../../scripts/prune-package-declarations.ts && tsc -p tsconfig.cjs.json && bun ../../scripts/write-cjs-package-json.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "pack:check": "bun run build && bun pm pack --destination .pack"
  }
}

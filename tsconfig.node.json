{
  "extends": "./tsconfig.strict.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./.typecheck/node",
    "rootDir": ".",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@openwaggle/extension-sdk": ["./packages/extension-sdk/src/index.ts"],
      "@openwaggle/extension-sdk/*": ["./packages/extension-sdk/src/*"],
      "@openwaggle/extension-react": ["./packages/extension-react/src/index.tsx"],
      "@openwaggle/pi-waggle": ["./packages/pi-waggle/src/index.ts"],
      "@openwaggle/pi-waggle/*": ["./packages/pi-waggle/src/*"],
      "@openwaggle/waggle-core": ["./packages/waggle-core/src/index.ts"],
      "@openwaggle/waggle-core/*": ["./packages/waggle-core/src/*"],
      "electrobun": ["./vendor/electrobun/types/config/ElectrobunConfig.d.ts"],
      "electrobun/main": ["./vendor/electrobun/types/sdks/main/index.d.ts"],
      "electrobun/view": ["./vendor/electrobun/types/browser/index.d.ts"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "packages/**/*.ts",
    /*
     * The scripts that src/main tests, functions and the website import. The rest of scripts/,
     * with electron.vite.config.ts and electron-builder.ts, is tsconfig.scripts.json.
     */
    "scripts/installed-docs-generator.ts",
    "scripts/installed-docs-generator-model.ts",
    "scripts/package-documentation-model.ts",
    "scripts/package-documentation-renderer.ts",
    "scripts/qa/child-process-lifecycle.ts",
    "scripts/qa/windows-process-tree.ts",
    "scripts/usage-stats-snapshot-endpoint.ts",
    "functions/**/*.ts",
    "website/src/lib/**/*.ts",
    "website/src/data/docs-nav.ts",
    "doctor.config.ts",
    "oxlint.config.mts"
  ],
  "exclude": [
    "**/node_modules",
    "packages/*/dist",
    "packages/*/dist-cjs",
    "packages/*/.pack",
    ".typecheck"
  ]
}

---
import { developerDocsNav, docsNav, isDeveloperDoc } from '@/data/docs-nav';
import SidebarNav from './SidebarNav.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const developerArea = isDeveloperDoc(currentPath.replace(/^\/docs\//, ''));
const sections = developerArea ? developerDocsNav : docsNav;
const otherArea = developerArea
  ? { title: 'User guide', href: '/docs/getting-started/first-run/' }
  : { title: 'Developer docs', href: '/docs/developer-guide/building-from-source/' };
---

{/* The same nav renders in the desktop and the mobile sidebar */}
<Fragment>
  {/* Desktop sidebar */}
  <aside class="docs-sidebar w-64 shrink-0 overflow-y-auto border-r border-border py-8 pr-6 hidden lg:block sticky top-16 h-[calc(100vh-4rem)]">
    <SidebarNav sections={sections} currentPath={currentPath} otherArea={otherArea} />
  </aside>

  {/* Mobile sidebar */}
  <div id="mobile-sidebar-overlay" class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden"></div>
  <aside id="mobile-sidebar" class="fixed left-0 top-16 z-50 hidden h-[calc(100vh-4rem)] w-72 overflow-y-auto border-r border-border bg-bg p-6 lg:hidden" role="dialog" aria-label="Documentation navigation">
    <SidebarNav sections={sections} currentPath={currentPath} otherArea={otherArea} linkClass="mobile-sidebar-link" />
  </aside>
</Fragment>

<script>
  const overlay = document.getElementById('mobile-sidebar-overlay');
  const sidebar = document.getElementById('mobile-sidebar');
  const toggle = document.getElementById('docs-sidebar-toggle');

  function closeSidebar() {
    overlay?.classList.add('hidden');
    sidebar?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  function openSidebar() {
    overlay?.classList.remove('hidden');
    sidebar?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = !sidebar?.classList.contains('hidden');
    if (isOpen) closeSidebar();
    else openSidebar();
  });

  overlay?.addEventListener('click', closeSidebar);

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !sidebar?.classList.contains('hidden')) {
      closeSidebar();
    }
  });

  // Close on nav link click (mobile)
  document.querySelectorAll('.mobile-sidebar-link').forEach((link) => {
    link.addEventListener('click', closeSidebar);
  });
</script>

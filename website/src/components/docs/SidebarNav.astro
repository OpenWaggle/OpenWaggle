---
import type { NavSection } from '@/data/docs-nav';
import { canonicalDocsPath } from '@/data/package-docs';

interface Props {
  sections: readonly NavSection[];
  currentPath: string;
  otherArea: { title: string; href: string };
  /** Extra class on each page link, such as the hook the mobile sidebar closes on. */
  linkClass?: string;
}

const { sections, currentPath, otherArea, linkClass } = Astro.props;
---

<nav aria-label="Documentation">
  <a href={otherArea.href} class="mb-6 block rounded-md border border-border-light px-3 py-2 text-sm text-accent hover:bg-bg-hover">{otherArea.title} <span aria-hidden="true">↗</span></a>
  {sections.map((section) => (
    <div class="mb-6">
      <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-text-tertiary">
        {section.title}
      </h3>
      <ul class="flex flex-col gap-0.5">
        {section.items.map((item) => {
          const path = `/docs/${item.slug}`;
          const href = canonicalDocsPath(item.slug);
          const isActive = currentPath === path || currentPath.startsWith(`${path}/`);
          return (
            <li>
              <a
                href={href}
                class:list={[
                  linkClass,
                  'block rounded-md px-3 py-1.5 text-[13px] transition-colors',
                  isActive
                    ? 'bg-bg-tertiary text-accent font-medium'
                    : 'text-text-tertiary hover:text-text-secondary hover:bg-bg-hover',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.title}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>

---
const features = [
  {
    title: 'Review code changes',
    description: 'Read the diff, comment on individual lines, or send a batch of feedback to the agent. Stage and commit changes in the app.',
    href: '/docs/developer-workflow/git-integration',
    link: 'Git and diff review',
  },
  {
    title: 'Show the agent what you mean',
    description: 'Use the built-in browser to check your app. Attach an element, a region, or a drawing to your next message.',
    href: '/docs/developer-workflow/browser-preview',
    link: 'Browser preview',
  },
  {
    title: 'Try a different approach',
    description: 'Branch a conversation from an earlier message without deleting the original thread. Conversation branches are separate from Git branches.',
    href: '/docs/using-openwaggle/session-tree',
    link: 'Conversation branches',
  },
  {
    title: 'Add your own tools and instructions',
    description: 'Give the agent project instructions, load reusable skills, and connect external tools through MCP.',
    href: '/docs/extending/agents-md',
    link: 'Project instructions',
  },
];
---

<section class="mx-auto max-w-6xl px-6 md:px-12" aria-labelledby="workflow-heading">
  <div class="border-t border-border-light py-12">
    <h2 id="workflow-heading" class="font-display text-3xl font-semibold tracking-tight">Beyond the conversation</h2>
    <div class="mt-8 grid gap-x-16 gap-y-10 md:grid-cols-2">
      {features.map(({ title, description, href, link }) => (
        <div>
          <h3 class="font-display text-xl font-semibold">{title}</h3>
          <p class="mt-3 text-base leading-relaxed text-text-tertiary">{description}</p>
          <a href={href} class="mt-4 inline-block text-sm text-accent underline-offset-4 hover:underline">{link} <span aria-hidden="true">→</span></a>
        </div>
      ))}
    </div>
  </div>
</section>

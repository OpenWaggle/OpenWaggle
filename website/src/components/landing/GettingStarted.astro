<section class="mx-auto max-w-6xl px-6 md:px-12" aria-labelledby="setup-heading">
  <div class="border-t border-border-light py-12">
    <h2 id="setup-heading" class="font-display text-3xl font-semibold tracking-tight">Get started</h2>
    <div class="mt-8 grid gap-x-16 gap-y-10 md:grid-cols-2">
      <div>
        <h3 class="font-display text-xl font-semibold">Connect a provider</h3>
        <p class="mt-3 leading-relaxed text-text-tertiary">Choose your provider and enable a model in Settings. Use an API key or sign in through the browser where supported. Provider usage costs and limits still apply.</p>
        <a href="/docs/providers/overview" class="mt-4 inline-block text-sm text-accent underline-offset-4 hover:underline">Provider setup <span aria-hidden="true">→</span></a>
      </div>
      <div>
        <h3 class="font-display text-xl font-semibold">Open your project</h3>
        <p class="mt-3 leading-relaxed text-text-tertiary">Open a local project folder and ask a question about the code. The walkthrough takes you through requesting a small change, checking approvals, and reviewing the diff.</p>
        <a href="/docs/getting-started/first-run" class="mt-4 inline-block text-sm text-accent underline-offset-4 hover:underline">Follow the walkthrough <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

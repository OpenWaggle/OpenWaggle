<section class="mx-auto max-w-6xl px-6 md:px-12" aria-labelledby="multiple-agents-heading">
  <div class="border-t border-border-light py-12">
    <div class="border-l-2 border-accent/50 pl-6">
      <h2 id="multiple-agents-heading" class="font-display text-2xl font-semibold tracking-tight">When you want more than one agent</h2>
      <p class="mt-3 text-text-tertiary">Optional ways to share a task across agents.</p>
      <div class="mt-8 grid gap-x-16 gap-y-10 md:grid-cols-2">
        <div>
          <h3 class="font-display text-xl font-semibold">Waggle</h3>
          <p class="mt-3 leading-relaxed text-text-tertiary">Pair two agents on the same task. They take turns in one conversation, using the model and role you choose for each.</p>
          <a href="/docs/using-openwaggle/waggle-mode" class="mt-4 inline-block text-sm text-accent underline-offset-4 hover:underline">Waggle guide <span aria-hidden="true">→</span></a>
        </div>
        <div>
          <h3 class="font-display text-xl font-semibold">Hives</h3>
          <p class="mt-3 leading-relaxed text-text-tertiary">Delegate work to separate agent sessions. Each worker has its own conversation, and you can open it directly to follow the work.</p>
          <a href="/docs/using-openwaggle/hives-and-sessions" class="mt-4 inline-block text-sm text-accent underline-offset-4 hover:underline">Hives and sessions <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

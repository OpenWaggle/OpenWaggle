---
import Button from '@/components/ui/Button.astro';
import HoneycombBackground from '@/components/HoneycombBackground.astro';
import ProductDemo from '@/components/landing/ProductDemo.astro';
---

<section class="relative isolate overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true" style="background: radial-gradient(ellipse 68% 45% at 50% 8%, #f5a62330, #b874100e 62%, transparent)"></div>
  <HoneycombBackground />
  <div class="relative mx-auto max-w-6xl px-6 pb-12 pt-14 md:px-12 md:pt-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="mb-5 text-xs font-medium uppercase tracking-widest text-accent">OpenWaggle</p>
      <h1 class="text-balance font-display text-4xl font-semibold leading-tight tracking-tight md:text-6xl">
        A desktop app for coding with AI.
      </h1>
      <p class="mx-auto mt-6 max-w-lg text-pretty text-lg leading-relaxed text-text-secondary">
        Work in your project, review code changes, and check the result in a built-in browser.
      </p>
      <div class="mt-7">
        <Button href="https://github.com/OpenWaggle/OpenWaggle/releases">Download OpenWaggle</Button>
      </div>
      <p class="mt-4 text-xs text-text-tertiary">macOS · Windows · Linux</p>
    </div>
    <div class="mt-10">
      <div class="mb-2 flex flex-wrap items-center justify-between gap-2 text-xs text-text-tertiary">
        <span>Inside OpenWaggle</span>
        <Button id="honeycomb-motion" variant="ghost" size="small" class="honeycomb-motion hidden" aria-pressed="false">
          Pause background animation
        </Button>
      </div>
      <ProductDemo />
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .honeycomb-motion { display: none; }
  }
</style>

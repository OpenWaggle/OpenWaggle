---
const RADIUS = 40;
const HALF_RADIUS = RADIUS / 2;
const ROW_HEIGHT = RADIUS * Math.sqrt(3);
const HALF_ROW = ROW_HEIGHT / 2;
const TILE_WIDTH = RADIUS * 3;
const VERTICES = [
  [RADIUS, 0], [HALF_RADIUS, HALF_ROW], [-HALF_RADIUS, HALF_ROW],
  [-RADIUS, 0], [-HALF_RADIUS, -HALF_ROW], [HALF_RADIUS, -HALF_ROW],
] as const;
// Adjacent columns are offset by half a row so every hex shares all six edges.
const CENTRES = [
  [0, 0], [0, ROW_HEIGHT], [RADIUS + HALF_RADIUS, HALF_ROW],
  [TILE_WIDTH, 0], [TILE_WIDTH, ROW_HEIGHT],
] as const;
const outline = CENTRES.map(([x, y]) =>
  `M${VERTICES.map(([dx, dy]) => `${x + dx} ${y + dy}`).join(' ')}Z`,
).join(' ');
---

<div id="honeycomb-background" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[730px] overflow-hidden" aria-hidden="true">
  <svg class="absolute inset-0 h-full w-full text-accent" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="honeycomb-tile" width={TILE_WIDTH} height={ROW_HEIGHT} patternUnits="userSpaceOnUse">
        <path d={outline} fill="none" stroke="white" stroke-width="0.8" />
      </pattern>
      <mask id="honeycomb-lines">
        <rect width="100%" height="100%" fill="url(#honeycomb-tile)" />
      </mask>
      <radialGradient id="honeycomb-light">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.16" />
        <stop offset="50%" stop-color="currentColor" stop-opacity="0.06" />
        <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
      </radialGradient>
    </defs>
    <g mask="url(#honeycomb-lines)">
      <rect width="100%" height="100%" fill="currentColor" opacity="0.075" />
      <ellipse class="honeycomb-light" cx="22%" cy="30%" rx="32%" ry="40%" fill="url(#honeycomb-light)" />
    </g>
  </svg>
</div>

<style>
  #honeycomb-background { mask-image: linear-gradient(#000 0%, #000 65%, transparent 100%); }
  .honeycomb-light { transform-box: view-box; }
  @keyframes honeycomb-drift {
    from { transform: translate(-18%, -3%); }
    to { transform: translate(48%, 15%); }
  }
  @media (prefers-reduced-motion: no-preference) {
    #honeycomb-background[data-ready] .honeycomb-light {
      animation: honeycomb-drift 48s ease-in-out infinite alternate;
    }
  }
  #honeycomb-background[data-paused] .honeycomb-light,
  #honeycomb-background[data-offscreen] .honeycomb-light { animation-play-state: paused; }
</style>

<script>
  const background = document.getElementById('honeycomb-background');
  const control = document.getElementById('honeycomb-motion');
  if (background && control) {
    control.classList.remove('hidden');
    background.setAttribute('data-ready', '');
    control.addEventListener('click', () => {
      const paused = background.toggleAttribute('data-paused');
      control.setAttribute('aria-pressed', String(paused));
      control.textContent = paused ? 'Resume background animation' : 'Pause background animation';
    });
    let onScreen = true;
    const syncVisibility = () => background.toggleAttribute('data-offscreen', !onScreen || document.hidden);
    new IntersectionObserver((entries) => {
      onScreen = entries.some((entry) => entry.isIntersecting);
      syncVisibility();
    }).observe(background);
    document.addEventListener('visibilitychange', syncVisibility);
    syncVisibility();
  }
</script>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/landing/Hero.astro';
import MultipleAgents from '@/components/landing/MultipleAgents.astro';
import MakeItYours from '@/components/landing/MakeItYours.astro';
import CoreFeatures from '@/components/landing/CoreFeatures.astro';
import GettingStarted from '@/components/landing/GettingStarted.astro';
import CommonQuestions from '@/components/landing/CommonQuestions.astro';
import { organizationJsonLd, softwareApplicationJsonLd, websiteJsonLd } from '@/lib/seo';
---

<BaseLayout jsonLd={[organizationJsonLd(), websiteJsonLd(), softwareApplicationJsonLd()]}>
  <Hero />
  <MakeItYours />
  <CoreFeatures />
  <GettingStarted />
  <MultipleAgents />
  <CommonQuestions />
</BaseLayout>

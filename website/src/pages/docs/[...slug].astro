---
import { getCollection, render } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import PackageAliasRedirect from '@/components/docs/PackageAliasRedirect.astro';
import { packageDocumentation } from '@/data/package-docs';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const routes = docs.map((entry) => {
    const routeSlug = entry.id.replace(/\/index$/u, '');
    return {
      params: { slug: routeSlug },
      props: { entry, routeSlug },
    };
  });

  // Indexed once: a .find() per package would rescan every doc entry.
  const docsById = new Map(docs.map((entry) => [entry.id, entry]));

  for (const definition of packageDocumentation) {
    const currentEntryId = `packages/${definition.slug}/${definition.currentVersion}/index`;
    const currentEntry = docsById.get(currentEntryId);
    if (!currentEntry) {
      throw new Error(`Missing current package documentation entry: ${currentEntryId}`);
    }
    routes.push({
      params: { slug: `packages/${definition.slug}` },
      props: { entry: currentEntry, routeSlug: `packages/${definition.slug}` },
    });
  }

  return routes;
}

const { entry, routeSlug } = Astro.props;
const canonicalSlug = entry.id.replace(/\/index$/u, '');
const { Content } = await render(entry);
---

{/* Static Astro 302 redirects add a two-second delay. Keep latest aliases immediate. */}
{routeSlug !== canonicalSlug ? (
  <PackageAliasRedirect
    destination={new URL(`/docs/${canonicalSlug}/`, Astro.site)}
    title={entry.data.title}
  />
) : (
  <DocsLayout title={entry.data.title} description={entry.data.description} slug={routeSlug}>
    <Content />
  </DocsLayout>
)}

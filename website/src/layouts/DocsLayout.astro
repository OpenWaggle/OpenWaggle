---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '@/components/docs/Sidebar.astro';
import PrevNext from '@/components/docs/PrevNext.astro';
import Button from '@/components/ui/Button.astro';
import PackageInstallTabs from '@/components/docs/PackageInstallTabs.astro';
import PackageVersionSelect from '@/components/docs/PackageVersionSelect.astro';
import { packageDocumentationPage } from '@/data/package-docs';
import { docsArticleJsonLd, DEFAULT_DESCRIPTION } from '@/lib/seo';
import { docsPath } from '@/lib/site-paths';

interface Props {
  title: string;
  description?: string;
  slug: string;
}

const { title, description, slug } = Astro.props;
const packagePage = packageDocumentationPage(slug);
const navigationSlug = packagePage ? `packages/${packagePage.definition.slug}` : slug;
const pageDescription = description ?? DEFAULT_DESCRIPTION;
const jsonLd = docsArticleJsonLd({
  title,
  description: pageDescription,
  path: Astro.url.pathname,
  breadcrumbs: [
    { name: 'Docs', path: docsPath('getting-started/first-run') },
    { name: title, path: Astro.url.pathname },
  ],
});
---

<BaseLayout title={`${title} | OpenWaggle Docs`} description={pageDescription} type="article" jsonLd={jsonLd}>
  <div class="mx-auto flex max-w-[1440px] px-6 md:px-20">
    <Sidebar />

    <div class="min-w-0 flex-1 py-8 lg:pl-12">
      <!-- Mobile sidebar toggle + search -->
      <div class="mb-6 flex items-center gap-4 lg:hidden">
        <Button
          id="docs-sidebar-toggle"
          variant="secondary"
          size="icon"
          aria-label="Toggle sidebar"
          aria-expanded="false"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </Button>
      </div>

      <article class="prose-docs">
        {packagePage && (
          <PackageVersionSelect
            definition={packagePage.definition}
            page={packagePage.page}
            version={packagePage.version}
          />
        )}
        <h1 class="mb-2 font-display text-3xl font-bold text-text-primary">{title}</h1>
        {description && (
          <p class="mb-8 text-base text-text-tertiary">{description}</p>
        )}
        <slot />
      </article>

      <PrevNext currentSlug={navigationSlug} />
    </div>
  </div>

  <PackageInstallTabs />
</BaseLayout>

{
  "name": "openwaggle",
  "version": "1.0.0-beta.38",
  "description": "Desktop coding agent with multi-model waggle mode",
  "main": "./out/main/boot.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare:native:node": "bun scripts/rebuild-native-deps.ts node",
    "prepare:native:electron": "bun scripts/rebuild-native-deps.ts electron",
    "prepare:semantic-model": "bun scripts/prepare-session-embedding-model.ts",
    "benchmark:session-embedding": "bun scripts/benchmark-session-embedding.ts",
    "evaluate:agent-context": "bun scripts/evaluate-agent-context.ts",
    "evaluate:session-titles": "bun scripts/evaluate-session-titles.ts",
    "perf:bedrock-ttfb": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run -c vitest.integration.config.ts scripts/perf/bedrock-ttfb",
    "perf:first-turn-prefix": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run -c vitest.integration.config.ts scripts/perf/first-turn-prefix",
    "perf:first-turn-prefix:packaged": "bun scripts/perf/first-turn-prefix-packaged.ts",
    "perf:generate-profile": "bun scripts/perf/generate-profile.ts",
    "perf:hive-memory": "bun scripts/perf/hive-memory.ts",
    "perf:startup": "bun scripts/perf/startup.ts",
    "perf:streaming": "bun scripts/perf/streaming.ts",
    "perf:idle-host": "bun scripts/perf/idle-host.ts",
    "perf:session-open": "bun scripts/perf/session-open.ts",
    "pr:create": "bun scripts/pr/create.ts",
    "pr:ready": "bun scripts/pr/ready.ts",
    "pr:watch": "bun scripts/pr/watch.ts",
    "benchmark:session-vector-index": "bun scripts/benchmark-session-vector-index.ts",
    "benchmark:session-database": "bun scripts/benchmark-session-discovery-database.ts",
    "benchmark:session-performance": "bun run benchmark:session-embedding && bun run benchmark:session-vector-index && bun run benchmark:session-database --migration-scale",
    "benchmark:session-release": "bun run benchmark:session-embedding && bun run benchmark:session-vector-index && bun run benchmark:session-database",
    "dev": "bun run docs:generate && bun run prepare:native:electron && bun scripts/run-electron-dev.ts vite",
    "dev:debug": "bun run docs:generate && bun run prepare:native:electron && bun scripts/start-electron-qa.ts",
    "dev:debug:headed": "bun run docs:generate && bun run prepare:native:electron && bun scripts/run-electron-dev.ts vite -- --remote-debugging-port=9222",
    "cli:dev": "bun scripts/run-electron-dev.ts electron",
    "prototype:composer": "vite prototypes/composer --host 127.0.0.1",
    "prototype:actions": "node prototypes/project-actions/serve.mts",
    "build": "bun run docs:generate && bun run prepare:semantic-model && bun run prepare:native:electron && electron-vite build && bun run check:syntax-bundle && bun run check:main-bundle && bun scripts/record-build-meta.ts",
    "build:package-dependencies": "bun run --filter @openwaggle/waggle-core build && bun run --filter @openwaggle/extension-sdk build",
    "build:packages": "bun run build:package-dependencies && bun run --filter @openwaggle/pi-waggle build && bun run --filter @openwaggle/extension-react build",
    "package:smoke": "bun scripts/package-smoke.ts",
    "packaged-app:smoke": "bun scripts/packaged-app-smoke.ts",
    "packaged-syntax:smoke": "bun scripts/packaged-syntax-smoke.ts",
    "pi-main-bundle:smoke": "bun scripts/pi-main-bundle-smoke.ts",
    "preview": "bun run prepare:native:electron && electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:mac": "bun run build && bun scripts/build-mac.ts",
    "build:mac:all": "bun run build && electron-builder --mac --arm64 --x64",
    "build:win": "bun run build && electron-builder --win",
    "build:linux": "bun run build && electron-builder --linux",
    "build:website": "cd website && bun install && bun run build",
    "extension:qa:install": "bun scripts/install-extension-qa-fixture.ts",
    "qa:seed-conversations": "bun scripts/qa/seed-dev-conversations.ts",
    "qa:session-orchestration:live": "bun scripts/qa/live-session-orchestration-smoke.ts",
    "qa:packaged-session-host-startup": "bun scripts/qa/packaged-session-host-startup-smoke.ts",
    "qa:dev-app-startup": "bun scripts/qa/dev-app-startup-smoke.ts",
    "typecheck": "bun scripts/check/run.ts --only typecheck",
    "test": "bun run prepare:native:node && bun run test:unit:raw && bun run test:integration:raw && bun run test:component && bun run test:mcp:conformance",
    "test:all": "bun run test",
    "test:unit": "bun run prepare:native:node && bun run test:unit:raw",
    "test:unit:raw": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true bun --bun vitest run -c vitest.unit.config.ts",
    "test:node-runtime": "bun run prepare:native:node && bun run test:node-runtime:raw",
    "test:node-runtime:raw": "bun scripts/node-runtime-tests.ts unit",
    "test:node-runtime:integration:raw": "bun scripts/node-runtime-tests.ts integration",
    "test:component": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true bun --bun vitest run -c vitest.component.config.ts",
    "test:mcp": "bun run test:mcp:local && bun run test:mcp:conformance",
    "test:mcp:local": "bun run prepare:native:node && VITE_CONFIG_NATIVE_IGNORE_WARNING=true bun --bun vitest run -c vitest.unit.config.ts mcp && VITE_CONFIG_NATIVE_IGNORE_WARNING=true bun --bun vitest run -c vitest.component.config.ts mcp",
    "test:mcp:conformance": "conformance client --command \"bun scripts/node-script-bundle.ts --run scripts/mcp-conformance-client.mts\" --scenario initialize --spec-version 2025-11-25 --timeout 60000 && conformance client --command \"bun scripts/node-script-bundle.ts --run scripts/mcp-conformance-client.mts\" --scenario tools_call --spec-version 2025-11-25 --timeout 60000 && conformance client --command \"bun scripts/node-script-bundle.ts --run scripts/mcp-conformance-client.mts\" --scenario json-schema-2020-12-preservation --spec-version 2025-11-25 --timeout 60000 && bun run test:mcp:server-conformance",
    "test:mcp:server-conformance": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true bun --bun vitest run -c vitest.integration.config.ts src/main/__tests__/openwaggle-mcp-server-conformance.integration.test.ts src/main/__tests__/openwaggle-mcp-server-profile-authority.integration.test.ts",
    "test:integration": "bun run prepare:native:node && bun run test:integration:raw",
    "test:integration:raw": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true bun --bun vitest run -c vitest.integration.config.ts",
    "test:coverage": "bun run prepare:native:node && VITE_CONFIG_NATIVE_IGNORE_WARNING=true bun --bun vitest run -c vitest.coverage.config.ts --coverage",
    "test:agent-definitions:platform": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true bun --bun vitest run -c vitest.unit.config.ts src/main/agents/__tests__/agent-definition-bound-catalog-reader.unit.test.ts src/main/agents/__tests__/agent-definition-bound-mutation-recovery.unit.test.ts src/main/agents/__tests__/agent-definition-files.unit.test.ts",
    "test:session-host-shutdown:platform": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true node node_modules/vitest/vitest.mjs run -c vitest.integration.config.ts scripts/qa/__tests__/session-host-shutdown.integration.test.ts",
    "lint": "bun scripts/check/run.ts --only format,lint,repository-standards",
    "lint:fix": "bun run build:package-dependencies && bun scripts/lint.ts --fix && bun run check:repository-standards",
    "lint:oxlint": "bun scripts/lint.ts --runner=oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:repository-standards": "bun scripts/check-repository-standards.ts",
    "skills-lock:drift": "bun scripts/skills-lock.ts drift",
    "tokens:count": "bun scripts/count-o200k-tokens.ts",
    "check:waggle-dead-code": "bun scripts/check-waggle-dead-code.ts",
    "api:snapshot:check": "bun run build:packages && bun scripts/package-api-snapshots.ts --check",
    "api:snapshot:update": "bun run build:packages && bun scripts/package-api-snapshots.ts --update",
    "api:snapshot:update:dry-run": "bun run build:packages && bun scripts/package-api-snapshots.ts --update --dry-run",
    "package-docs:check": "bun scripts/package-documentation.ts --check",
    "package-docs:update": "bun scripts/package-documentation.ts --update",
    "check:commits": "bun scripts/check-conventional-commits.ts",
    "check:commits:local": "bun scripts/check-conventional-commits-local.ts",
    "package-release:bootstrap": "bun scripts/package-release-bootstrap.ts",
    "package-release:publish": "node scripts/package-release-publish.ts",
    "package-release:validate": "bun scripts/package-release-validator.ts",
    "check:fast": "bun scripts/check/run.ts --only typecheck,format,lint,repository-standards",
    "check:installer": "bun scripts/check-installer-script.ts",
    "check:contrast": "bun scripts/check-contrast.ts",
    "check:pi-runtime": "bun scripts/check-pi-runtime-alignment.ts",
    "check:provenance": "bun scripts/check-provenance-downgrade.ts",
    "check:dependency-pins": "bun scripts/check-dependency-pins.ts",
    "check:no-cheating": "bun scripts/check-no-cheating.ts",
    "check:coverage-uniqueness": "bun scripts/coverage-uniqueness.ts advise",
    "check:usage-statistics-catalog": "bun scripts/generate-usage-statistics-catalog.ts --check",
    "usage-statistics-catalog:generate": "bun scripts/generate-usage-statistics-catalog.ts",
    "syntax-languages:generate": "bun scripts/generate-syntax-language-metadata.ts",
    "check:syntax-bundle": "bun scripts/check-syntax-bundle.ts",
    "check:main-bundle": "bun scripts/check-main-bundle.ts",
    "check:renderer-csp": "bun scripts/check-renderer-csp.ts",
    "check:react-compiler": "bun scripts/check-react-compiler.ts",
    "check:fallow": "fallow dead-code --fail-on-issues --quiet --format compact && fallow --only dupes --fail-on-issues --quiet --format compact",
    "check:react-doctor": "react-doctor . --no-score --no-supply-chain --blocking warning -y",
    "check:renderer-bundle": "electron-vite build && bun run check:syntax-bundle && bun run check:main-bundle && bun run check:renderer-csp",
    "check": "bun scripts/check/run.ts check",
    "check:changed": "bun scripts/check/run.ts --changed",
    "verify": "bun scripts/check/run.ts verify",
    "prepush:main": "bun run check && bun run format && bun run test:all",
    "website:capture-screenshots": "bun run prepare:native:electron && electron-vite build && bun scripts/capture-website-screenshots.ts",
    "prepare": "husky",
    "website:dev": "bun run --filter @openwaggle/website dev",
    "website:build": "bun run package-docs:check && bun run --filter @openwaggle/website build",
    "website:preview": "bun run --filter @openwaggle/website preview",
    "website:test": "bun run --filter @openwaggle/website test",
    "website:schemas": "bun scripts/generate-published-json-schemas.ts",
    "docs:generate": "bun scripts/generate-installed-docs.ts",
    "benchmark:syntax": "bun scripts/benchmarks/syntax-highlighting.ts --check"
  },

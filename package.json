{
  "name": "openwaggle",
  "version": "0.3.0-alpha.59",
  "description": "Desktop coding agent with multi-model waggle mode",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare:native:node": "tsx scripts/rebuild-native-deps.ts node",
    "prepare:native:electron": "tsx scripts/rebuild-native-deps.ts electron",
    "dev": "pnpm docs:generate && pnpm prepare:native:electron && env -u ELECTRON_RUN_AS_NODE ELECTRON_ENABLE_LOGGING=1 electron-vite dev",
    "dev:debug": "pnpm docs:generate && pnpm prepare:native:electron && env -u ELECTRON_RUN_AS_NODE ELECTRON_ENABLE_LOGGING=1 electron-vite dev -- --remote-debugging-port=9222",
    "build": "pnpm docs:generate && pnpm prepare:native:electron && electron-vite build",
    "build:package-dependencies": "pnpm --filter @openwaggle/waggle-core build && pnpm --filter @openwaggle/extension-sdk build",
    "build:packages": "pnpm build:package-dependencies && pnpm --filter @openwaggle/pi-waggle build && pnpm --filter @openwaggle/extension-react build",
    "package:smoke": "tsx scripts/package-smoke.ts",
    "packaged-app:smoke": "tsx scripts/packaged-app-smoke.ts",
    "preview": "pnpm prepare:native:electron && electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:mac": "pnpm build && tsx scripts/build-mac.ts",
    "build:mac:all": "pnpm build && electron-builder --mac --arm64 --x64",
    "build:win": "pnpm build && electron-builder --win",
    "build:linux": "pnpm build && electron-builder --linux",
    "build:website": "cd website && pnpm install && pnpm build",
    "extension:qa:install": "tsx scripts/install-extension-qa-fixture.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc -b tsconfig.web.json --emitDeclarationOnly",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "pnpm prepare:native:node && pnpm test:unit:raw && pnpm test:integration:raw && pnpm test:component && pnpm test:mcp:conformance",
    "test:all": "pnpm test && pnpm test:e2e:headless",
    "test:unit": "pnpm prepare:native:node && pnpm test:unit:raw",
    "test:unit:raw": "vitest run -c vitest.unit.config.ts",
    "test:component": "vitest run -c vitest.component.config.ts",
    "test:mcp": "pnpm test:mcp:local && pnpm test:mcp:conformance",
    "test:mcp:local": "pnpm prepare:native:node && vitest run -c vitest.unit.config.ts mcp && vitest run -c vitest.component.config.ts mcp",
    "test:mcp:conformance": "conformance client --command \"pnpm exec tsx scripts/mcp-conformance-client.ts\" --scenario initialize --spec-version 2025-11-25 --timeout 60000 && conformance client --command \"pnpm exec tsx scripts/mcp-conformance-client.ts\" --scenario tools_call --spec-version 2025-11-25 --timeout 60000 && conformance client --command \"pnpm exec tsx scripts/mcp-conformance-client.ts\" --scenario tools_call --spec-version 2026-07-28 --timeout 60000 && conformance client --command \"pnpm exec tsx scripts/mcp-conformance-client.ts\" --scenario request-metadata --spec-version 2026-07-28 --timeout 60000 && conformance client --command \"pnpm exec tsx scripts/mcp-conformance-client.ts\" --scenario json-schema-ref-no-deref --spec-version 2026-07-28 --timeout 60000 && conformance client --command \"pnpm exec tsx scripts/mcp-conformance-client.ts\" --scenario json-schema-2020-12-preservation --spec-version 2026-07-28 --timeout 60000",
    "test:integration": "pnpm prepare:native:node && pnpm test:integration:raw",
    "test:integration:raw": "vitest run -c vitest.integration.config.ts",
    "test:coverage": "pnpm prepare:native:node && vitest run -c vitest.coverage.config.ts --coverage",
    "test:e2e": "pnpm test:e2e:headless",
    "test:e2e:headless": "pnpm build && playwright test",
    "test:e2e:headless:quick": "pnpm prepare:native:electron && playwright test",
    "test:e2e:headed": "pnpm build && playwright test --headed",
    "test:e2e:headed:quick": "pnpm prepare:native:electron && playwright test --headed",
    "lint": "biome check src/ packages/ fixtures/ && pnpm build:package-dependencies && oxlint src packages scripts website electron.vite.config.ts playwright.config.ts --deny-warnings && eslint src packages scripts website electron.vite.config.ts playwright.config.ts --max-warnings=0 && pnpm check:repository-standards",
    "lint:fix": "biome check --write src/ packages/ fixtures/ && pnpm build:package-dependencies && oxlint src packages scripts website electron.vite.config.ts playwright.config.ts --fix --deny-warnings && eslint src packages scripts website electron.vite.config.ts playwright.config.ts --fix --max-warnings=0 && pnpm check:repository-standards",
    "format": "biome format --write src/ packages/ fixtures/",
    "check:repository-standards": "tsx scripts/check-repository-standards.ts",
    "api:snapshot:check": "pnpm build:packages && tsx scripts/package-api-snapshots.ts --check",
    "api:snapshot:update": "pnpm build:packages && tsx scripts/package-api-snapshots.ts --update",
    "api:snapshot:update:dry-run": "pnpm build:packages && tsx scripts/package-api-snapshots.ts --update --dry-run",
    "package-docs:check": "tsx scripts/package-documentation.ts --check",
    "package-docs:update": "tsx scripts/package-documentation.ts --update",
    "check:commits": "tsx scripts/check-conventional-commits.ts",
    "package-release:bootstrap": "tsx scripts/package-release-bootstrap.ts",
    "package-release:publish": "node scripts/package-release-publish.ts",
    "package-release:validate": "tsx scripts/package-release-validator.ts",
    "check:fast": "pnpm typecheck && pnpm lint",
    "check:installer": "tsx scripts/check-installer-script.ts",
    "check": "pnpm typecheck && pnpm check:installer && pnpm typecheck:tests && pnpm lint && pnpm package-release:validate && pnpm api:snapshot:check && pnpm package-docs:check && pnpm package:smoke",
    "prepush:main": "pnpm check && pnpm format && pnpm test:all",
    "website:capture-screenshots": "pnpm prepare:native:electron && tsx scripts/capture-website-screenshots.ts",
    "prepare": "husky",
    "website:dev": "pnpm --filter @openwaggle/website dev",
    "website:build": "pnpm package-docs:check && pnpm --filter @openwaggle/website build",
    "website:preview": "pnpm --filter @openwaggle/website preview",
    "website:test": "pnpm --filter @openwaggle/website test",
    "docs:generate": "tsx scripts/generate-installed-docs.ts",
    "typecheck:tests": "tsx scripts/check-renderer-test-types.ts"
  },
  "packageManager": "pnpm@11.15.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenWaggle/OpenWaggle.git"
  },
  "dependencies": {
    "@diegogbrisa/ts-match": "1.6.2",
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@lexical/react": "0.48.0",
    "@lobehub/icons-static-svg": "1.94.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@openwaggle/extension-sdk": "workspace:*",
    "@openwaggle/pi-waggle": "workspace:*",
    "@openwaggle/waggle-core": "workspace:*",
    "@pierre/diffs": "1.3.2",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-router": "1.170.18",
    "@huggingface/transformers": "4.2.0",
    "better-sqlite3": "13.0.1",
    "electron-updater": "6.8.9",
    "hast-util-to-jsx-runtime": "2.3.6",
    "ignore": "7.0.5",
    "jsonc-parser": "3.3.1",
    "lexical": "0.48.0",
    "ms": "2.1.3",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.3.1",
    "smol-toml": "1.6.1",
    "tesseract.js": "7.0.0",
    "typebox": "1.1.38",
    "undici": "7.29.0",
    "unified": "11.0.5",
    "ws": "8.21.3",
    "yauzl": "3.4.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@biomejs/biome": "2.5.5",
    "@effect/cluster": "0.60.0",
    "@effect/experimental": "0.61.0",
    "@effect/platform": "0.97.0",
    "@effect/platform-node": "0.108.0",
    "@effect/rpc": "0.76.0",
    "@effect/sql": "0.52.0",
    "@effect/sql-sqlite-node": "0.53.0",
    "@effect/workflow": "0.19.0",
    "@electron-toolkit/utils": "4.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@playwright/test": "1.61.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/router-plugin": "1.168.23",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@total-typescript/shoehorn": "0.1.2",
    "@types/hast": "3.0.5",
    "@types/node": "24.13.3",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "diff": "9.0.0",
    "effect": "3.22.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.7.0",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "fast-glob": "3.3.3",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "jszip": "3.10.1",
    "lucide-react": "1.25.0",
    "mammoth": "1.12.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.61.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-voice-visualizer": "2.1.0",
    "rehype-sanitize": "6.0.0",
    "release-please": "17.6.1",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "unpdf": "1.6.2",
    "vite": "8.1.5",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "zustand": "5.0.14"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-darwin-x64": "0.35.3",
    "@img/sharp-libvips-darwin-arm64": "1.3.2",
    "@img/sharp-libvips-darwin-x64": "1.3.2",
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3",
    "@img/sharp-win32-x64": "0.35.3",
    "@mariozechner/clipboard-darwin-arm64": "0.3.9",
    "@mariozechner/clipboard-darwin-x64": "0.3.9",
    "@mariozechner/clipboard-linux-x64-gnu": "0.3.9",
    "@mariozechner/clipboard-win32-x64-msvc": "0.3.9",
    "recheck-linux-x64": "4.5.0",
    "recheck-macos-arm64": "4.5.0",
    "recheck-macos-x64": "4.5.0",
    "recheck-windows-x64": "4.5.0"
  }
}

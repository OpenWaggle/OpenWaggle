{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.md",
    "**/*.mdx",
    "**/*.json",
    "**/*.jsonc",
    "**/*.yml",
    "**/*.css",
    "**/*.yaml",
    "**/*.html",
    "src/renderer/src/routeTree.gen.ts",
    "packages/**/dist/**",
    "packages/**/dist-cjs/**",
    "packages/**/.pack/**"
  ]
}

+static void SetupExitCallback(Napi::Env env, Napi::Function cb, pid_t pid,
+                              const std::string& process_identity,
+                              int owned_pidfd = -1) {
+  std::unique_ptr<ExitWaiterState> state(new ExitWaiterState);
+  state->env = env;
+  state->pid = pid;
+  state->process_identity = process_identity;
+#if defined(__APPLE__)
+  state->wait_fd = kqueue();
+  if (state->wait_fd == -1) throw Napi::Error::New(env, "kqueue failed.");
+  struct kevent user = {0};
+  EV_SET(&user, 1, EVFILT_USER, EV_ADD | EV_CLEAR, 0, 0, NULL);
+  if (HANDLE_EINTR(kevent(state->wait_fd, &user, 1, NULL, 0, NULL)) == -1) {
+    close(state->wait_fd);
+    state->wait_fd = -1;
+    throw Napi::Error::New(env, "Could not register exit-waiter cancellation.");
+  }
+  struct kevent process = {0};
+  EV_SET(&process, pid, EVFILT_PROC, EV_ADD | EV_ONESHOT, NOTE_EXIT, 0, NULL);
+  if (HANDLE_EINTR(kevent(state->wait_fd, &process, 1, NULL, 0, NULL)) == 0) {
+    state->process_filter_registered = true;
+  } else if (errno != ESRCH) {
+    close(state->wait_fd);
+    state->wait_fd = -1;
+    throw Napi::Error::New(env, "Could not register process exit waiter.");
+  }
+#elif defined(__linux__)
+  state->pidfd = owned_pidfd;
+  if (state->pidfd < 0) throw Napi::Error::New(env, "Missing owned pidfd.");
+  state->cancel_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+  if (state->cancel_fd == -1) {
+    close(state->pidfd);
+    state->pidfd = -1;
+    throw Napi::Error::New(env, "eventfd failed.");
+  }
+#else
+  (void)owned_pidfd;
+#endif
+
+  ExitWaiterState* raw_state = state.get();
+  state->tsfn = Napi::ThreadSafeFunction::New(
+      env, cb, "SetupExitCallback_resource", 0, 1,
+      [raw_state](Napi::Env finalizer_env) {
+        FinalizeExitWaiter(finalizer_env, raw_state);
+      });
+  try {
+    state->tsfn.Unref(env);
+  } catch (...) {
+    state->tsfn.Release();
+    state.release();
+    throw;
+  }
+  napi_status hook_status = napi_add_env_cleanup_hook(env, CancelExitWaiter, state.get());
+  if (hook_status != napi_ok) {
+    state->tsfn.Release();
+    state.release();
+    throw Napi::Error::New(env, "Could not register process waiter cleanup.");
+  }
+  state->cleanup_hook_registered.store(true, std::memory_order_release);
+  try {
+    state->thread = std::thread(RunExitWaiter, state.get());
+  } catch (...) {
+    napi_remove_env_cleanup_hook(env, CancelExitWaiter, state.get());
+    state->cleanup_hook_registered.store(false, std::memory_order_release);
+    state->tsfn.Release();
+    state.release();
+    throw;
+  }
+  state.release();
+}

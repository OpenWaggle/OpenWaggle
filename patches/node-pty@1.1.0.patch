+#if defined(__APPLE__)
+static ProcessReadResult ReadDarwinUnique(pid_t pid,
+                                          ProcUniqueIdentifierInfo* result) {
+  memset(result, 0, sizeof(*result));
+  errno = 0;
+  int size = proc_pidinfo(pid, PROC_PIDUNIQIDENTIFIERINFO, 0, result,
+                          sizeof(*result));
+  if (size == static_cast<int>(sizeof(*result))) return ProcessReadResult::kFound;
+  if (size == 0 && (errno == 0 || errno == ESRCH || errno == ENOENT)) {
+    return ProcessReadResult::kAbsent;
+  }
+  return ProcessReadResult::kError;
+}
+
+static ProcessReadResult ReadProcessInfo(AddonState*, pid_t pid,
+                                         KernelProcessInfo* result, bool) {
+  ProcUniqueIdentifierInfo before;
+  ProcessReadResult unique_result = ReadDarwinUnique(pid, &before);
+  if (unique_result != ProcessReadResult::kFound) return unique_result;
+
+  int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_PID, pid};
+  struct kinfo_proc process;
+  memset(&process, 0, sizeof(process));
+  size_t size = sizeof(process);
+  errno = 0;
+  if (sysctl(mib, 4, &process, &size, NULL, 0) == -1) {
+    if (errno == ESRCH || errno == ENOENT) return ProcessReadResult::kAbsent;
+    return ProcessReadResult::kError;
+  }
+  if (size == 0) return ProcessReadResult::kAbsent;
+  if (size != sizeof(process) || process.kp_proc.p_pid != pid) {
+    return ProcessReadResult::kError;
+  }
+
+  ProcUniqueIdentifierInfo after;
+  unique_result = ReadDarwinUnique(pid, &after);
+  if (unique_result != ProcessReadResult::kFound) return unique_result;
+  if (before.unique_id != after.unique_id) return ProcessReadResult::kAbsent;
+
+  result->pid = pid;
+  result->ppid = process.kp_eproc.e_ppid;
+  result->pgid = process.kp_eproc.e_pgid;
+  result->tpgid = process.kp_eproc.e_tpgid;
+  result->uid = process.kp_eproc.e_pcred.p_ruid;
+  result->unique_id = after.unique_id;
+  result->id_version = static_cast<uint32_t>(after.id_version);
+  result->started_at = "darwin:" + std::to_string(after.unique_id);
+  if (process.kp_eproc.e_tdev != NODEV && process.kp_eproc.e_tdev != 0) {
+    result->tty_identity = FormatTtyIdentity(process.kp_eproc.e_tdev);
+  }
+  result->zombie = process.kp_proc.p_stat == SZOMB;
+  result->name = process.kp_proc.p_comm[0] == '\0' ? "?" : process.kp_proc.p_comm;
+  return ProcessReadResult::kFound;
+}

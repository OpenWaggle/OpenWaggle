+// PtyConnect is synchronous in node-pty because spawn() must return a positive
+// pid. Bound the unavoidable worker handshake to a small fraction of a second,
+// rather than ever freezing Electron for seconds when the worker cannot open
+// the pipe.
+static constexpr DWORD PIPE_CONNECT_TIMEOUT_MS = 200;
+static constexpr DWORD JOB_QUIESCE_TIMEOUT_MS = 5000;
+static constexpr DWORD OUTPUT_DRAIN_ACK_TIMEOUT_MS = 5000;
+
+// This runs only on the native waiter. It turns a termination request into an
+// authoritative tree-quiesced proof before closing the last Job handle. The
+// root handle has already signaled when this is called; ActiveProcesses covers
+// descendants that may outlive the shell.
+static DWORD FinalizePtyJob(int id, bool* treeTerminated) {
+  *treeTerminated = false;
+  HANDLE hJob = nullptr;
+  {
+    std::lock_guard<std::mutex> lock(g_ptyHandlesMutex);
+    pty_baton* baton = get_pty_baton(lock, id);
+    if (baton == nullptr) {
+      return ERROR_INVALID_HANDLE;
+    }
+    if (baton->jobCloseCompleted) {
+      *treeTerminated = baton->jobCloseError == ERROR_SUCCESS;
+      return baton->jobCloseError;
+    }
+    if (!baton->processAssignedToJob) {
+      baton->jobCloseCompleted = true;
+      baton->jobCloseError = ERROR_SUCCESS;
+      *treeTerminated = true;
+      return ERROR_SUCCESS;
+    }
+    if (baton->hJob == nullptr) {
+      baton->jobCloseError = ERROR_INVALID_HANDLE;
+      return baton->jobCloseError;
+    }
+    hJob = baton->hJob;
+  }
+
+  DWORD terminationError = ERROR_SUCCESS;
+  if (!TerminateJobObject(hJob, 1)) {
+    terminationError = GetLastError();
+  }
+
+  DWORD quiesceError = terminationError;
+  const ULONGLONG startedAt = GetTickCount64();
+  for (;;) {
+    JOBOBJECT_BASIC_ACCOUNTING_INFORMATION accounting{};
+    if (QueryInformationJobObject(
+          hJob,
+          JobObjectBasicAccountingInformation,
+          &accounting,
+          sizeof(accounting),
+          nullptr)) {
+      if (accounting.ActiveProcesses == 0) {
+        quiesceError = ERROR_SUCCESS;
+        break;
+      }
+    } else {
+      quiesceError = GetLastError();
+      break;
+    }
+    if (GetTickCount64() - startedAt >= JOB_QUIESCE_TIMEOUT_MS) {
+      quiesceError = ERROR_SEM_TIMEOUT;
+      break;
+    }
+    Sleep(1);
+  }
+
+  std::lock_guard<std::mutex> lock(g_ptyHandlesMutex);
+  pty_baton* baton = get_pty_baton(lock, id);
+  if (baton == nullptr || baton->hJob != hJob) {
+    return ERROR_INVALID_HANDLE;
+  }
+  if (quiesceError == ERROR_SUCCESS) {
+    if (!CloseHandle(hJob)) {
+      quiesceError = GetLastError();
+    } else {
+      baton->hJob = nullptr;
+      baton->jobCloseCompleted = true;
+      *treeTerminated = true;
+    }
+  }
+  baton->jobCloseError = quiesceError;
+  return quiesceError;
+}

+static int SignalDarwinIdentity(pid_t pid, uint64_t expected_unique_id,
+                                int signal_number) {
+  for (int attempt = 0; attempt < 4; attempt++) {
+    ProcUniqueIdentifierInfo current;
+    ProcessReadResult read = ReadDarwinUnique(pid, &current);
+    if (read == ProcessReadResult::kAbsent) return 0;
+    if (read == ProcessReadResult::kError) return -2;
+    if (current.unique_id != expected_unique_id) return -1;
+
+    audit_token_t token;
+    memset(&token, 0, sizeof(token));
+    token.val[5] = static_cast<uint32_t>(pid);
+    token.val[7] = static_cast<uint32_t>(current.id_version);
+    errno = 0;
+    int result = proc_signal_with_audittoken(&token, signal_number);
+    if (result == 0) return 1;
+    int error = result == -1 ? errno : result;
+    if (error != ESRCH) return -2;
+
+    ProcUniqueIdentifierInfo after;
+    read = ReadDarwinUnique(pid, &after);
+    if (read == ProcessReadResult::kAbsent) return 0;
+    if (read == ProcessReadResult::kError) return -2;
+    if (after.unique_id != expected_unique_id) return -1;
+    if (after.id_version == current.id_version) return 0;
+    // exec(2) changes id_version but not p_uniqueid. Retry with the new
+    // kernel-issued audit token while the immutable identity still matches.
+  }
+  return -2;
+}
+
+static int SignalProcessIdentity(AddonState*, pid_t pid,
+                                 const std::string& identity,
+                                 int signal_number) {
+  KernelProcessInfo current;
+  ProcessReadResult read = ReadProcessInfo(nullptr, pid, &current);
+  if (read == ProcessReadResult::kAbsent) return 0;
+  if (read == ProcessReadResult::kError) return -2;
+  if (current.started_at != identity) return -1;
+  return SignalDarwinIdentity(pid, current.unique_id, signal_number);
+}

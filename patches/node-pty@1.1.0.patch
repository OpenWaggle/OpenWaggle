+Napi::Value PtyProcessInfos(const Napi::CallbackInfo& info) {
+  Napi::Env env(info.Env());
+  Napi::HandleScope scope(env);
+  if (info.Length() != 1 || !info[0].IsArray()) {
+    throw Napi::TypeError::New(env, "Usage: pty.processInfos(pids)");
+  }
+  Napi::Array requested = info[0].As<Napi::Array>();
+  if (requested.Length() > 32) {
+    throw Napi::RangeError::New(env, "processInfos accepts at most 32 PIDs.");
+  }
+  AddonState* state = env.GetInstanceData<AddonState>();
+  if (state == nullptr) throw Napi::Error::New(env, "Missing native process state.");
+
+  std::unordered_set<pid_t> seen;
+  Napi::Array result = Napi::Array::New(env);
+  uint32_t output_index = 0;
+  for (uint32_t index = 0; index < requested.Length(); index++) {
+    pid_t pid;
+    if (!ReadPositivePid(requested.Get(index), &pid) || !seen.insert(pid).second) {
+      throw Napi::TypeError::New(env, "PIDs must be unique positive integers.");
+    }
+    KernelProcessInfo process;
+    ProcessReadResult read = ReadProcessInfo(state, pid, &process);
+    if (read == ProcessReadResult::kAbsent) continue;
+    if (read == ProcessReadResult::kError) {
+      throw Napi::Error::New(env, "Could not read a stable process identity.");
+    }
+    Napi::Object value = Napi::Object::New(env);
+    value.Set("pid", Napi::Number::New(env, process.pid));
+    value.Set("startedAt", Napi::String::New(env, process.started_at));
+    value.Set("ppid", Napi::Number::New(env, process.ppid));
+    value.Set("pgid", Napi::Number::New(env, process.pgid));
+    value.Set("tpgid", Napi::Number::New(env, process.tpgid));
+    if (process.tty_identity.empty()) value.Set("ttyIdentity", env.Null());
+    else value.Set("ttyIdentity", Napi::String::New(env, process.tty_identity));
+    value.Set("zombie", Napi::Boolean::New(env, process.zombie));
+    value.Set("name", Napi::String::New(env, process.name));
+    result.Set(output_index++, value);
+  }
+  return result;
+}

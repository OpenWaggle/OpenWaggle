+static void FinalizeExitWaiter(Napi::Env env, ExitWaiterState* state) {
+  if (state->cleanup_hook_registered.exchange(false, std::memory_order_acq_rel) &&
+      !state->env_closing.load(std::memory_order_acquire)) {
+    napi_remove_env_cleanup_hook(env, CancelExitWaiter, state);
+  }
+  WakeExitWaiter(state);
+  if (state->thread.joinable()) state->thread.join();
+#if defined(__APPLE__)
+  if (state->wait_fd >= 0) close(state->wait_fd);
+  state->wait_fd = -1;
+#elif defined(__linux__)
+  if (state->pidfd >= 0) close(state->pidfd);
+  if (state->cancel_fd >= 0) close(state->cancel_fd);
+  state->pidfd = -1;
+  state->cancel_fd = -1;
+#endif
+  delete state;
+}

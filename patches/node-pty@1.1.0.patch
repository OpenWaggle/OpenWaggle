+static bool ReadTtyIdentity(int fd, std::string* identity) {
+  char slave_name[PATH_MAX] = {0};
+#if defined(__APPLE__)
+  if (ioctl(fd, TIOCPTYGNAME, slave_name) == -1) return false;
+#elif defined(__linux__)
+  if (ptsname_r(fd, slave_name, sizeof(slave_name)) != 0) return false;
+#else
+  char* name = ptsname(fd);
+  if (name == nullptr || strlen(name) >= sizeof(slave_name)) return false;
+  strcpy(slave_name, name);
+#endif
+  struct stat descriptor_stat;
+  if (stat(slave_name, &descriptor_stat) == -1 || !S_ISCHR(descriptor_stat.st_mode)) {
+    return false;
+  }
+#if defined(__linux__)
+  *identity = FormatLinuxTtyIdentity(descriptor_stat.st_dev, descriptor_stat.st_rdev);
+#else
+  *identity = FormatTtyIdentity(descriptor_stat.st_rdev);
+#endif
+  return true;
+}

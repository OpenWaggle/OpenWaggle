new file mode 100644
index 0000000000000000000000000000000000000000..3acdc81eedfdc21206e85e467a592f5bb5c9f5d3
--- /dev/null
+++ b/src/win/terminal-telemetry.cc
@@ -0,0 +1,198 @@
+// Bounded asynchronous Windows metadata queries, without spawning PowerShell.
+#define _WIN32_WINNT 0x600
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+#include <tlhelp32.h>
+#include <iphlpapi.h>
+#include <memory>
+#include <string>
+#include <vector>
+#include "terminal-telemetry.h"
+
+namespace {
+constexpr size_t kMaxRows = 16384;
+constexpr size_t kMaxTableBytes = 4 * 1024 * 1024;
+constexpr ULONGLONG kQueryDeadlineMs = 1000;
+constexpr int kTableAttempts = 3;
+
+struct HandleCloser {
+  void operator()(void* handle) const {
+    if (handle && handle != INVALID_HANDLE_VALUE) CloseHandle(handle);
+  }
+};
+using OwnedHandle = std::unique_ptr<void, HandleCloser>;
+
+ULONGLONG FileTimeValue(const FILETIME& time) {
+  return (static_cast<ULONGLONG>(time.dwHighDateTime) << 32) | time.dwLowDateTime;
+}
+
+struct ProcessRow {
+  DWORD pid;
+  DWORD ppid;
+  ULONGLONG created;
+  std::wstring name;
+};
+
+struct PortRow {
+  DWORD pid;
+  unsigned short port;
+  std::string host;
+};
+
+class TelemetryWorker : public Napi::AsyncWorker {
+ public:
+  TelemetryWorker(Napi::Env env, bool ports)
+      : Napi::AsyncWorker(env), deferred_(Napi::Promise::Deferred::New(env)), ports_(ports) {}
+  Napi::Promise Promise() const { return deferred_.Promise(); }
+
+  void Execute() override {
+    deadline_ = GetTickCount64() + kQueryDeadlineMs;
+    if (ports_) {
+      ReadPorts(AF_INET);
+      if (!Failed()) ReadPorts(AF_INET6);
+    } else {
+      ReadProcesses();
+    }
+  }
+
+  void OnOK() override {
+    Napi::Env env = Env();
+    const size_t count = ports_ ? portsData_.size() : processes_.size();
+    Napi::Array rows = Napi::Array::New(env, count);
+    for (size_t index = 0; index < count; ++index) {
+      Napi::Object row = Napi::Object::New(env);
+      if (ports_) {
+        const auto& port = portsData_[index];
+        row.Set("pid", port.pid);
+        row.Set("port", port.port);
+        row.Set("host", port.host);
+      } else {
+        const auto& process = processes_[index];
+        row.Set("pid", process.pid);
+        row.Set("ppid", process.ppid);
+        row.Set("startedAt", std::to_string(process.created));
+        row.Set("name", Napi::String::New(env,
+          reinterpret_cast<const char16_t*>(process.name.data()), process.name.size()));
+      }
+      rows.Set(static_cast<uint32_t>(index), row);
+    }
+    deferred_.Resolve(rows);
+  }
+
+  void OnError(const Napi::Error& error) override { deferred_.Reject(error.Value()); }
+
+ private:
+  bool Failed() const { return failed_; }
+  void Fail(const char* message) { failed_ = true; SetError(message); }
+  bool WithinBudget(size_t count) {
+    if (count >= kMaxRows || GetTickCount64() >= deadline_) {
+      Fail("Terminal metadata query exceeded its bounded budget");
+      return false;
+    }
+    return true;
+  }
+
+  void ReadProcesses() {
+    FILETIME snapshotTime;
+    GetSystemTimeAsFileTime(&snapshotTime);
+    const ULONGLONG latestCreation = FileTimeValue(snapshotTime);
+    OwnedHandle snapshot(CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0));
+    if (snapshot.get() == INVALID_HANDLE_VALUE) {
+      Fail("Unable to snapshot Windows terminal process metadata");
+      return;
+    }
+    PROCESSENTRY32W entry = {};
+    entry.dwSize = sizeof(entry);
+    BOOL found = Process32FirstW(snapshot.get(), &entry);
+    DWORD enumerationError = found ? ERROR_SUCCESS : GetLastError();
+    size_t visited = 0;
+    while (found) {
+      if (!WithinBudget(visited++)) return;
+      OwnedHandle process(OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, entry.th32ProcessID));
+      FILETIME created, exited, kernel, user;
+      if (process && GetProcessTimes(process.get(), &created, &exited, &kernel, &user)) {
+        const ULONGLONG birth = FileTimeValue(created);
+        // A PID born after the snapshot may have replaced the snapshotted row.
+        if (birth > 0 && birth <= latestCreation) {
+          processes_.push_back({entry.th32ProcessID, entry.th32ParentProcessID, birth, entry.szExeFile});
+        }
+      }
+      // Protected/system processes are omitted, never reported as owned children.
+      found = Process32NextW(snapshot.get(), &entry);
+      if (!found) enumerationError = GetLastError();
+    }
+    if (enumerationError != ERROR_NO_MORE_FILES) Fail("Incomplete Windows process snapshot");
+  }
+
+  void ReadPorts(ULONG family) {
+    ULONG bytes = 0;
+    ULONG status = GetExtendedTcpTable(nullptr, &bytes, FALSE, family, TCP_TABLE_OWNER_PID_LISTENER, 0);
+    std::vector<unsigned char> buffer;
+    for (int attempt = 0; status == ERROR_INSUFFICIENT_BUFFER && attempt < kTableAttempts; ++attempt) {
+      if (!WithinBudget(portsData_.size())) return;
+      if (bytes == 0 || bytes > kMaxTableBytes) { Fail("TCP listener table exceeds its byte limit"); return; }

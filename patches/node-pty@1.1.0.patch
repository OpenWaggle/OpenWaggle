+// ConPTY currently requires synchronous input/output handles, so the server
+// pipes cannot use FILE_FLAG_OVERLAPPED. Probe for an already-connected client
+// with a fixed deadline before calling ConnectNamedPipe. Once CreateFile has
+// connected the client, ConnectNamedPipe is guaranteed to return immediately
+// with either success, ERROR_PIPE_CONNECTED, or a disconnect error.
+static DWORD ConnectNamedPipeWithDeadline(int id, HANDLE pipe, ULONGLONG startedAt) {
+  for (;;) {
+    ULONG clientProcessId = 0;
+    if (GetNamedPipeClientProcessId(pipe, &clientProcessId)) {
+      if (ConnectNamedPipe(pipe, nullptr)) {
+        return static_cast<DWORD>(ERROR_SUCCESS);
+      }
+      const DWORD error = GetLastError();
+      return error == ERROR_PIPE_CONNECTED
+        ? static_cast<DWORD>(ERROR_SUCCESS)
+        : error;
+    }
+
+    const DWORD probeError = GetLastError();
+    if (probeError != ERROR_NOT_FOUND &&
+        probeError != ERROR_PIPE_LISTENING &&
+        probeError != ERROR_PIPE_NOT_CONNECTED &&
+        probeError != ERROR_NO_DATA) {
+      return probeError;
+    }
+
+    {
+      std::lock_guard<std::mutex> lock(g_ptyHandlesMutex);
+      const pty_baton* baton = get_pty_baton(lock, id);
+      if (baton == nullptr || baton->closeRequested) {
+        return ERROR_OPERATION_ABORTED;
+      }
+    }
+
+    if (GetTickCount64() - startedAt >= PIPE_CONNECT_TIMEOUT_MS) {
+      return ERROR_SEM_TIMEOUT;
+    }
+    Sleep(1);
+  }
+}

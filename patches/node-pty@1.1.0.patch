+static Napi::Value PtyAcknowledgeTreeExit(const Napi::CallbackInfo& info) {
+  Napi::Env env(info.Env());
+  Napi::HandleScope scope(env);
+
+  if (info.Length() != 1 || !info[0].IsNumber()) {
+    throw Napi::Error::New(env, "Usage: pty.acknowledgeTreeExit(id)");
+  }
+
+  const int id = info[0].As<Napi::Number>().Int32Value();
+  std::lock_guard<std::mutex> lock(g_ptyHandlesMutex);
+  const pty_baton* baton = get_pty_baton(lock, id);
+  // A late callback can race the bounded waiter and resource removal. The
+  // drain has already completed in that case, so acknowledgement is idempotent.
+  if (baton == nullptr || baton->hDrainReady == nullptr) {
+    return env.Undefined();
+  }
+  if (!SetEvent(baton->hDrainReady)) {
+    throw errorWithCode(info, "Unable to acknowledge ConPTY output drain");
+  }
+  return env.Undefined();
+}

+  if (child_info.si_code == CLD_KILLED || child_info.si_code == CLD_DUMPED) {
+    event->signal_code = child_info.si_status;
+  }
+  return true;
+#else
+  (void)pidfd;
+  (void)event;
+  (void)options;
+  return false;
+#endif

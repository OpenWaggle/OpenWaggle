+      status = GetExtendedTcpTable(buffer.data(), &bytes, FALSE, family, TCP_TABLE_OWNER_PID_LISTENER, 0);
+    }
+    if (status != NO_ERROR || buffer.empty() || GetTickCount64() >= deadline_) {
+      Fail("Unable to snapshot Windows TCP listeners");
+      return;
+    }
+    if (family == AF_INET) {
+      const auto* table = reinterpret_cast<const MIB_TCPTABLE_OWNER_PID*>(buffer.data());
+      if (buffer.size() < offsetof(MIB_TCPTABLE_OWNER_PID, table) ||
+          table->dwNumEntries > (buffer.size() - offsetof(MIB_TCPTABLE_OWNER_PID, table)) / sizeof(MIB_TCPROW_OWNER_PID)) {
+        Fail("Invalid IPv4 listener table"); return;
+      }
+      for (DWORD index = 0; index < table->dwNumEntries; ++index) {
+        if (!WithinBudget(portsData_.size())) return;
+        const auto& row = table->table[index];
+        char address[INET_ADDRSTRLEN] = {};
+        if (!InetNtopA(AF_INET, const_cast<DWORD*>(&row.dwLocalAddr), address, sizeof(address))) {
+          Fail("Unable to format IPv4 listener address"); return;
+        }
+        portsData_.push_back({row.dwOwningPid, ntohs(static_cast<u_short>(row.dwLocalPort)), address});
+      }
+    } else {
+      const auto* table = reinterpret_cast<const MIB_TCP6TABLE_OWNER_PID*>(buffer.data());
+      if (buffer.size() < offsetof(MIB_TCP6TABLE_OWNER_PID, table) ||
+          table->dwNumEntries > (buffer.size() - offsetof(MIB_TCP6TABLE_OWNER_PID, table)) / sizeof(MIB_TCP6ROW_OWNER_PID)) {
+        Fail("Invalid IPv6 listener table"); return;
+      }
+      for (DWORD index = 0; index < table->dwNumEntries; ++index) {
+        if (!WithinBudget(portsData_.size())) return;
+        const auto& row = table->table[index];
+        char address[INET6_ADDRSTRLEN] = {};
+        if (!InetNtopA(AF_INET6, const_cast<UCHAR*>(row.ucLocalAddr), address, sizeof(address))) {
+          Fail("Unable to format IPv6 listener address"); return;
+        }
+        std::string host(address);
+        if (row.dwLocalScopeId) host += "%" + std::to_string(row.dwLocalScopeId);
+        portsData_.push_back({row.dwOwningPid, ntohs(static_cast<u_short>(row.dwLocalPort)), host});
+      }
+    }
+  }
+
+  Napi::Promise::Deferred deferred_;

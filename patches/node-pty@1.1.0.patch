+static void RemoveLinuxCapability(AddonState* state, pid_t pid) {
+  auto found = state->capabilities.find(pid);
+  if (found == state->capabilities.end()) return;
+  if (found->second.pidfd >= 0) close(found->second.pidfd);
+  state->capabilities.erase(found);
+}
+
+static void PruneLinuxCapabilities(AddonState* state) {
+  for (auto iterator = state->capabilities.begin();
+       iterator != state->capabilities.end();) {
+    short events = 0;
+    if (!PidfdEvents(iterator->second.pidfd, &events) ||
+        (events & (POLLHUP | POLLERR | POLLNVAL))) {
+      close(iterator->second.pidfd);
+      iterator = state->capabilities.erase(iterator);
+    } else {
+      ++iterator;
+    }
+  }
+}
+
+static ProcessReadResult ReadProcessInfo(AddonState* state, pid_t pid,
+                                         KernelProcessInfo* result,
+                                         bool allow_exited) {
+  int pidfd = OpenPidfd(pid);
+  if (pidfd == -1) {
+    return errno == ESRCH || errno == ENOENT
+        ? ProcessReadResult::kAbsent
+        : ProcessReadResult::kError;
+  }
+  if (fcntl(pidfd, F_SETFD, FD_CLOEXEC) == -1) {
+    close(pidfd);
+    return ProcessReadResult::kError;
+  }
+
+  ProcessReadResult read = ReadProcStat(state, pid, result);
+  if (read != ProcessReadResult::kFound) {
+    close(pidfd);
+    return read;
+  }
+  short events = 0;
+  if (!PidfdEvents(pidfd, &events)) {
+    close(pidfd);
+    return ProcessReadResult::kError;
+  }
+  if (events & (POLLERR | POLLNVAL)) {
+    close(pidfd);
+    return ProcessReadResult::kError;
+  }
+  if (events & POLLHUP) {
+    close(pidfd);
+    return ProcessReadResult::kAbsent;
+  }
+  if ((events & POLLIN) && !result->zombie && !allow_exited) {
+    close(pidfd);
+    return ProcessReadResult::kAbsent;
+  }
+
+  std::lock_guard<std::mutex> lock(state->mutex);
+  auto existing = state->capabilities.find(pid);
+  if (existing != state->capabilities.end()) {
+    short existing_events = 0;
+    if (PidfdEvents(existing->second.pidfd, &existing_events) &&
+        !(existing_events & (POLLERR | POLLNVAL)) &&
+        !(existing_events & POLLHUP) &&
+        existing->second.start_ticks == result->start_ticks) {
+      result->started_at = existing->second.token;
+      existing->second.last_seen = state->observation_clock++;
+      close(pidfd);
+      return ProcessReadResult::kFound;
+    }
+    RemoveLinuxCapability(state, pid);
+  }
+  PruneLinuxCapabilities(state);
+  static const size_t kMaximumCapabilities = 1024;
+  if (state->capabilities.size() >= kMaximumCapabilities) {
+    auto oldest = state->capabilities.end();
+    for (auto iterator = state->capabilities.begin();
+         iterator != state->capabilities.end(); ++iterator) {
+      if (oldest == state->capabilities.end() ||
+          iterator->second.last_seen < oldest->second.last_seen) oldest = iterator;
+    }
+    if (oldest == state->capabilities.end()) {
+      close(pidfd);
+      return ProcessReadResult::kError;
+    }
+    close(oldest->second.pidfd);
+    state->capabilities.erase(oldest);
+  }
+  std::string token = "linux:" + state->boot_id + ':' +
+      std::to_string(state->next_token++);
+  LinuxProcessCapability capability;
+  capability.pidfd = pidfd;
+  capability.start_ticks = result->start_ticks;
+  capability.token = token;
+  capability.last_seen = state->observation_clock++;
+  state->capabilities.emplace(pid, std::move(capability));
+  result->started_at = token;
+  return ProcessReadResult::kFound;
+}
+
+static int DuplicateLinuxCapability(AddonState* state, pid_t pid,
+                                    const std::string& identity) {
+  std::lock_guard<std::mutex> lock(state->mutex);
+  auto found = state->capabilities.find(pid);
+  if (found == state->capabilities.end() || found->second.token != identity) {
+    errno = ESRCH;
+    return -1;
+  }
+  return fcntl(found->second.pidfd, F_DUPFD_CLOEXEC, STDERR_FILENO + 1);
+}
+
+static int SignalProcessIdentity(AddonState* state, pid_t pid,
+                                 const std::string& identity,
+                                 int signal_number) {
+  std::lock_guard<std::mutex> lock(state->mutex);
+  auto found = state->capabilities.find(pid);
+  if (found == state->capabilities.end() || found->second.token != identity) {
+    int current_pidfd = OpenPidfd(pid);
+    if (current_pidfd == -1) {
+      if (errno == ESRCH || errno == ENOENT) return 0;
+      return -2;
+    }
+    short events = 0;
+    bool observed = PidfdEvents(current_pidfd, &events);
+    close(current_pidfd);
+    if (!observed) return -2;
+    if (events & (POLLERR | POLLNVAL)) return -2;
+    return (events & (POLLIN | POLLHUP)) ? 0 : -1;
+  }
+  short events = 0;
+  if (!PidfdEvents(found->second.pidfd, &events)) return -2;
+  if (events & (POLLERR | POLLNVAL)) return -2;
+  if (events & (POLLIN | POLLHUP)) return 0;
+  if (SendPidfdSignal(found->second.pidfd, signal_number) == 0) return 1;
+  return errno == ESRCH ? 0 : -2;
+}

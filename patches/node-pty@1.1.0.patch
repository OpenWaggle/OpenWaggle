+// Request termination without closing the Job handle. The waiter retains that
+// stable kernel identity until it has observed an empty Job and can publish a
+// tree-termination event. ClosePseudoConsole happens only after that event and
+// remains off the JavaScript thread.
+static DWORD RequestPtyClose(
+    int id,
+    bool* scheduleCleanup = nullptr,
+    bool* handleFound = nullptr) {
+  if (scheduleCleanup != nullptr) {
+    *scheduleCleanup = false;
+  }
+  if (handleFound != nullptr) {
+    *handleFound = false;
+  }
+  std::lock_guard<std::mutex> lock(g_ptyHandlesMutex);
+  pty_baton* baton = get_pty_baton(lock, id);
+  if (baton == nullptr) {
+    return ERROR_SUCCESS;
+  }
+  if (handleFound != nullptr) {
+    *handleFound = true;
+  }
+
+  // A close can race a native connect from another Node environment. Record
+  // the request even before the Job exists; connect will then either avoid
+  // CreateProcess entirely or kill the still-suspended process before resume.
+  baton->closeRequested = true;
+  if (baton->jobCloseCompleted) {
+    return baton->jobCloseError;
+  }
+  if (baton->hJob == nullptr) {
+    // A process assigned to a Job must never exist without either its live Job
+    // handle or a completed close record. Treat that as an ownership failure,
+    // not an idempotent success.
+    if (baton->processAssignedToJob) {
+      return ERROR_INVALID_HANDLE;
+    }
+    if (!baton->connecting && !baton->cleanupScheduled && scheduleCleanup != nullptr) {
+      baton->cleanupScheduled = true;
+      *scheduleCleanup = true;
+    }
+    return ERROR_SUCCESS;
+  }
+  if (!TerminateJobObject(baton->hJob, 1)) {
+    return GetLastError();
+  }
+  return ERROR_SUCCESS;
+}

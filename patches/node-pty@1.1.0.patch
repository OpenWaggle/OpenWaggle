+static bool KillVerifiedDirectChild(ExitWaiterState* state) {
+  int status = 0;
+  pid_t result;
+  do {
+    result = waitpid(state->pid, &status, WNOHANG);
+  } while (result == -1 && errno == EINTR);
+  if (result == state->pid) {
+    state->child_reaped = true;
+    state->child_status = status;
+    return true;
+  }
+  if (result != 0) return false;
+  return kill(state->pid, SIGKILL) == 0 || errno == ESRCH;
+}

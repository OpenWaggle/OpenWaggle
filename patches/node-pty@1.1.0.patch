+static bool ReadPositivePid(const Napi::Value& value, pid_t* pid) {
+  if (!value.IsNumber()) return false;
+  double number = value.As<Napi::Number>().DoubleValue();
+  if (!std::isfinite(number) || std::floor(number) != number ||
+      number < 1 || number > INT_MAX) return false;
+  *pid = static_cast<pid_t>(number);
+  return true;
+}
+
+static bool ReadBoundedInteger(const Napi::Value& value, int minimum,
+                               int maximum, int* result) {
+  if (!value.IsNumber()) return false;
+  double number = value.As<Napi::Number>().DoubleValue();
+  if (!std::isfinite(number) || std::floor(number) != number ||
+      number < minimum || number > maximum) return false;
+  *result = static_cast<int>(number);
+  return true;
+}

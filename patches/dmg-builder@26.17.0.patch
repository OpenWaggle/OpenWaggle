+// OpenWaggle patch: GitHub-hosted macOS runners intermittently fail hdiutil with a device error
+// while dmgbuild creates, attaches, resizes or converts the image (actions/runner-images#7522;
+// the OpenWaggle 1.0.0-beta.8 release run 37285929256 failed three times this way). Retry only
+// that failure, with backoff long enough to outlast a concurrent zip or signing pass. The wait
+// happens outside the toolset lock so a concurrent DMG target is not starved of it. Detach
+// failures are not retried: dmgbuild already retries detach itself.
+const TRANSIENT_DMGBUILD_HDIUTIL_ERROR = /hdiutil: (?:create|attach|convert|resize) failed - (?:Device not configured|Resource busy|Resource temporarily unavailable)/;
+const DMGBUILD_ATTEMPTS = 5;
+const DMGBUILD_RETRY_BASE_DELAY_MS = 30000;
+async function execDmgbuildWithRetry(file, args, artifactPath, options, baseDelayMs = DMGBUILD_RETRY_BASE_DELAY_MS) {
+    for (let attempt = 1;; attempt++) {
+        try {
+            return await (0, toolsetLock_1.withToolsetLock)(() => (0, builder_util_1.exec)(file, args, options));
+        }
+        catch (error) {
+            const transient = TRANSIENT_DMGBUILD_HDIUTIL_ERROR.exec(String((error === null || error === void 0 ? void 0 : error.message) || ""));
+            if (attempt >= DMGBUILD_ATTEMPTS || transient == null) {
+                throw error;
+            }
+            const delayMs = baseDelayMs * 2 ** (attempt - 1);
+            // The reason drops its "hdiutil: " prefix so a retry that later succeeds cannot make an
+            // unrelated build failure look transient to OpenWaggle's release-log classifier.
+            builder_util_1.log.warn({ attempt, attempts: DMGBUILD_ATTEMPTS, delayMs, reason: transient[0].replace(/^hdiutil: /, ""), file: artifactPath }, "dmgbuild hit a transient hdiutil error, retrying");
